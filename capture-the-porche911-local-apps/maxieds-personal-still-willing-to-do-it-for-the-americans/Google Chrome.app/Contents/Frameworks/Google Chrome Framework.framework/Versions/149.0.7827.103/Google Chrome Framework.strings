INSERT INTO local_traces_index(uuid, creation_time, scenario_name, upload_rule_name,upload_rule_value, state, upload_time, skip_reason,file_size) VALUES(?,?,?,?,?,?,?,?,?)
INSERT INTO local_traces_payloads(uuid, trace_content, system_profile) VALUES(?,?,?)
UPDATE local_traces_index SET state=? WHERE uuid=? AND NOT skip_reason=?
UPDATE local_traces_index SET state=?, upload_time=? WHERE uuid=?
SELECT trace_content FROM local_traces_payloads WHERE uuid=?
SELECT system_profile FROM local_traces_payloads WHERE uuid=?
DELETE FROM local_traces_index WHERE creation_time < ?
DELETE FROM local_traces_payloads WHERE uuid IN (SELECT uuid FROM local_traces_index WHERE state=? AND upload_time < ?)
DELETE FROM local_traces_payloads WHERE uuid NOT IN (SELECT uuid FROM local_traces_index ORDER BY creation_time DESC LIMIT ?)
SELECT i.uuid, creation_time, scenario_name, upload_rule_name, upload_rule_value, state, upload_time, skip_reason, file_size, p.uuid IS NOT NULL AS has_trace_content FROM local_traces_index AS i LEFT JOIN local_traces_payloads AS p ON i.uuid = p.uuid ORDER BY creation_time DESC
SELECT i.uuid, creation_time, scenario_name, upload_rule_name, upload_rule_value, state, upload_time, skip_reason, file_size, p.uuid IS NOT NULL AS has_trace_content FROM local_traces_index AS i LEFT JOIN local_traces_payloads AS p ON i.uuid = p.uuid WHERE state in (1,2) ORDER BY creation_time DESC
SELECT COUNT(uuid) FROM local_traces_index WHERE scenario_name = ? AND upload_rule_name = ? AND creation_time > ? AND skip_reason=?
SELECT scenario_name, COUNT(uuid) FROM local_traces_index WHERE creation_time > ? GROUP BY scenario_name
CREATE TABLE IF NOT EXISTS local_traces_index(uuid TEXT PRIMARY KEY NOT NULL,creation_time DATETIME NOT NULL,scenario_name TEXT NOT NULL,upload_rule_name TEXT NOT NULL,upload_rule_value INT NULL,state INT NOT NULL,upload_time DATETIME NULL,skip_reason INT NOT NULL,file_size INTEGER NOT NULL)
CREATE TABLE IF NOT EXISTS local_traces_payloads(uuid TEXT PRIMARY KEY NOT NULL,trace_content BLOB NULL,system_profile BLOB NULL,FOREIGN KEY(uuid) REFERENCES local_traces_index(uuid) ON DELETE CASCADE)
