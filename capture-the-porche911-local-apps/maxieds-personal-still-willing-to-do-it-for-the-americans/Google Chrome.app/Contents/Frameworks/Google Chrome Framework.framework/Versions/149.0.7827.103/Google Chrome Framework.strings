             'pop', 'push', 'reverse', 'find'],
            ['from', 'isArray']);
saveBuiltin(String,
            ['indexOf', 'slice', 'split', 'substr', 'toLowerCase',
             'toUpperCase', 'replace'],
            ['fromCharCode']);
