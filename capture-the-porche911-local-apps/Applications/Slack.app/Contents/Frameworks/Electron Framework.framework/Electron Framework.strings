float ToLinearSRGBIsh(float v, constant float* gabcdef) {
  float g = gabcdef[0];
  float a = gabcdef[1];
  float b = gabcdef[2];
  float c = gabcdef[3];
  float d = gabcdef[4];
  float e = gabcdef[5];
  float f = gabcdef[6];
  float abs_v = abs(v);
  float sgn_v = sign(v);
  if (abs_v < d)
