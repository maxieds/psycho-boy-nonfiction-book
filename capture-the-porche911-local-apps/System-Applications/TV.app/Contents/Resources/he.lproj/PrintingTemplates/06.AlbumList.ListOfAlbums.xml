<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<themeName>רשימת אלבומים</themeName>
	<themeExplanation>מדפיס אלבומים מרשימת ההשמעה או הספריה הנבחרת, כשהם ממוינים לפי אמן. אינו מדפיס שמות שירים.</themeExplanation>
	<themeKind>albumlist</themeKind>
	<themeInternalKind>playlist</themeInternalKind>
	<themeSortOrder>2</themeSortOrder>
	<themeMediaIndex>1</themeMediaIndex>
	<albumlist>
		<column>
			<field>artistName</field>
			<resizable/>
			<width>50</width>
		</column>
		<column>
			<field>albumName</field>
			<resizable/>
			<width>50</width>
		</column>
		<column>
			<columnName>מס׳ פריטים</columnName>
			<field>trackNumber</field>
			<width>25</width>
		</column>
		<column>
			<columnName>זמן כולל</columnName>
			<field>totalTime</field>
			<width>50</width>
		</column>
	</albumlist>
</theme>
