<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<themeName>Dates de lecture</themeName>
	<themeExplanation>Impression du nom, de la durée, de l’artiste, de l’album, du nombre de lectures et de la date des chansons de votre liste de lecture ou bibliothèque sélectionnée. Impression en orientation paysage.</themeExplanation>
	<themeKind>playlist</themeKind>
	<themeSortOrder>3</themeSortOrder>
	<themeMediaIndex>2</themeMediaIndex>
	<playlist>
		<column>
			<trackIndex />
			<width>10</width>
		</column>
		<column>
			<field>trackName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>totalTime</field>
			<width>40</width>
		</column>
		<column>
			<field>albumName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>artistName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>playDate</field>
			<resizable />
			<width>30</width>
		</column>
		<column>
			<field>playCount</field>
			<width>50</width>
		</column>
	</playlist>
</theme>
