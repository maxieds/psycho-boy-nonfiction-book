<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<themeName>قائمة الألبومات</themeName>
	<themeExplanation>طباعة الألبومات من قائمة التشغيل أو المكتبة التي حددتها، مصنفة حسب الفنان. لا تتم طباعة عناوين الأغاني.</themeExplanation>
	<themeKind>albumlist</themeKind>
	<themeInternalKind>playlist</themeInternalKind>
	<themeSortOrder>2</themeSortOrder>
	<themeMediaIndex>1</themeMediaIndex>
	<albumlist>
		<column>
			<field>artistName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>albumName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<columnName># من العناصر</columnName>
			<field>trackNumber</field>
			<width>25</width>
		</column>
		<column>
			<columnName>الوقت الكلي</columnName>
			<field>totalTime</field>
			<width>50</width>
		</column>
	</albumlist>
</theme>
