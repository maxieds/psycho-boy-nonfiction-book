<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<themeName>تصنيفات المستخدم</themeName>
	<themeExplanation>طباعة الاسم، والمدة، والفنان، والألبوم، والتصنيفات من الأغاني في قائمة التشغيل أو المكتبة التي حددتها. تتم الطباعة بنمط الاتجاه الأفقي.</themeExplanation>
	<themeKind>playlist</themeKind>
	<themeSortOrder>2</themeSortOrder>
	<themeMediaIndex>2</themeMediaIndex>
	<playlist>
		<column>
			<trackIndex />
			<width>10</width>
		</column>
		<column>
			<field>trackName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>totalTime</field>
			<width>40</width>
		</column>
		<column>
			<field>albumName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>artistName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>genre</field>
			<resizable />
			<width>30</width>
		</column>
		<column>
			<field>userRating</field>
			<width>25</width>
		</column>
	</playlist>
</theme>
