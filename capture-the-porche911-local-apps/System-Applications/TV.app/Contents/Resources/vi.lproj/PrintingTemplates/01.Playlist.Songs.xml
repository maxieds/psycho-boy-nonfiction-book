<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<themeName>Bài hát</themeName>
	<themeExplanation>In tên, độ dài, nghệ sỹ và album từ các bài hát trong danh sách phát hoặc thư viện được chọn của bạn. Sử dụng Thiết lập Trang để điều khiển hướng.</themeExplanation>
	<themeKind>playlist</themeKind>
	<themeSortOrder>1</themeSortOrder>
	<themeMediaIndex>1</themeMediaIndex>
	<playlist>
		<column>
			<trackIndex />
			<width>10</width>
		</column>
		<column>
			<field>trackName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>totalTime</field>
			<width>40</width>
		</column>
		<column>
			<field>albumName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>artistName</field>
			<resizable />
			<width>50</width>
		</column>
	</playlist>
</theme>
