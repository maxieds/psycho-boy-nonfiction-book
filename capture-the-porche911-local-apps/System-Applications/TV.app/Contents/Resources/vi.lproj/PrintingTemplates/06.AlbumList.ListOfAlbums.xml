<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<themeName>Danh sách album</themeName>
	<themeExplanation>In các album từ danh sách phát hoặc thư viện được chọn của bạn, được sắp xếp theo nghệ sỹ. Không in tiêu đề bài hát.</themeExplanation>
	<themeKind>albumlist</themeKind>
	<themeInternalKind>playlist</themeInternalKind>
	<themeSortOrder>2</themeSortOrder>
	<themeMediaIndex>1</themeMediaIndex>
	<albumlist>
		<column>
			<field>artistName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>albumName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<columnName>Số mục</columnName>
			<field>trackNumber</field>
			<width>25</width>
		</column>
		<column>
			<columnName>Tổng Thời gian</columnName>
			<field>totalTime</field>
			<width>50</width>
		</column>
	</albumlist>
</theme>
