<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<themeName>चलाए जाने की तिथि</themeName>
	<themeExplanation>आपकी चयनित गीतमाला या लाइब्रेरी में गीतों से नाम, लंबाई, कलाकार, ऐल्बम, चलाए जाने की संख्या और तिथि को प्रिंट किया जाता है। लैंडस्केप ओरिएंटेशन में प्रिंट किया जाता है।</themeExplanation>
	<themeKind>playlist</themeKind>
	<themeSortOrder>3</themeSortOrder>
	<themeMediaIndex>2</themeMediaIndex>
	<playlist>
		<column>
			<trackIndex />
			<width>10</width>
		</column>
		<column>
			<field>trackName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>totalTime</field>
			<width>40</width>
		</column>
		<column>
			<field>albumName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>artistName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>playDate</field>
			<resizable />
			<width>30</width>
		</column>
		<column>
			<field>playCount</field>
			<width>50</width>
		</column>
	</playlist>
</theme>
