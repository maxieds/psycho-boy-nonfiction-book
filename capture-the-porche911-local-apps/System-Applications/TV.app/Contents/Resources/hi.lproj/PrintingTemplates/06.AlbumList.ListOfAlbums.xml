<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<themeName>ऐल्बम की सूची</themeName>
	<themeExplanation>आपकी चयनित गीतमाला या लाइब्रेरी से कलाकारों के अनुसार क्रमित किए गए ऐल्बम को प्रिंट किया जाता है। गीत के शीर्षक प्रिंट नहीं किए जाते हैं।</themeExplanation>
	<themeKind>albumlist</themeKind>
	<themeInternalKind>playlist</themeInternalKind>
	<themeSortOrder>2</themeSortOrder>
	<themeMediaIndex>1</themeMediaIndex>
	<albumlist>
		<column>
			<field>artistName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>albumName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<columnName># आइटम</columnName>
			<field>trackNumber</field>
			<width>25</width>
		</column>
		<column>
			<columnName>कुल समय</columnName>
			<field>totalTime</field>
			<width>50</width>
		</column>
	</albumlist>
</theme>
