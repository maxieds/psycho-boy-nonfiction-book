<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<themeName>Tarikh dimainkan</themeName>
	<themeExplanation>Mencetak nama, jangka masa, artis, album, bilangan mainan dan tarikh daripada lagu dalam senarai main atau pustaka pilihan anda. Dicetak dalam orientasi landskap.</themeExplanation>
	<themeKind>playlist</themeKind>
	<themeSortOrder>3</themeSortOrder>
	<themeMediaIndex>2</themeMediaIndex>
	<playlist>
		<column>
			<trackIndex />
			<width>10</width>
		</column>
		<column>
			<field>trackName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>totalTime</field>
			<width>40</width>
		</column>
		<column>
			<field>albumName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>artistName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>playDate</field>
			<resizable />
			<width>30</width>
		</column>
		<column>
			<field>playCount</field>
			<width>50</width>
		</column>
	</playlist>
</theme>
