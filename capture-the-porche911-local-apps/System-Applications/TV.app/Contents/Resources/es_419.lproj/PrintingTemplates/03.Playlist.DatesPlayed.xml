<?xml version="1.0" encoding="UTF-8"?>
<theme>
	<themeName>Fecha y reproducciones</themeName>
	<themeExplanation>Imprime el nombre, duración, artista, álbum, número de reproducciones y fecha de las canciones en la biblioteca o lista de reproducción seleccionada. Se imprime con orientación horizontal.</themeExplanation>
	<themeKind>playlist</themeKind>
	<themeSortOrder>3</themeSortOrder>
	<themeMediaIndex>2</themeMediaIndex>
	<playlist>
		<column>
			<trackIndex />
			<width>10</width>
		</column>
		<column>
			<field>trackName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>totalTime</field>
			<width>40</width>
		</column>
		<column>
			<field>albumName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>artistName</field>
			<resizable />
			<width>50</width>
		</column>
		<column>
			<field>playDate</field>
			<resizable />
			<width>30</width>
		</column>
		<column>
			<field>playCount</field>
			<width>50</width>
		</column>
	</playlist>
</theme>
