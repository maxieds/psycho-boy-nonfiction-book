(version 1)

(deny default)

(import "system.sb")

(import "com.apple.corefoundation.sb")
(corefoundation)

(allow file-read*)
(allow file-write* (subpath "/"))
(allow file-issue-extension (require-all (extension-class "com.apple.app-sandbox.read-write") (subpath "/")))

(allow process-fork)
(allow process-exec (literal "/usr/sbin/screencapture") (with no-sandbox))
(allow signal (target children))
