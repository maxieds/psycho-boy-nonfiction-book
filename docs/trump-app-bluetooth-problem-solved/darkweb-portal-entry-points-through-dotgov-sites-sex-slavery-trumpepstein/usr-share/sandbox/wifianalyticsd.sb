;;
;; WARNING: The sandbox rules in this file currently constitute 
;; Apple System Private Interface and are subject to change at any time and
;; without notice. The contents of this file are also auto-generated and not
;; user editable; it may be overwritten at any time.
;;

(version 1)
(deny default)
(import "system.sb")

(allow signal)
(allow pseudo-tty)

(allow file-ioctl
    (literal "/dev/ptmx")
    (regex #"^/dev/ttys")
)

(allow file-read-metadata)
(allow file-read-data)
(allow file-read-xattr)

(allow file-write*
    (literal "/var/mobile/.wa/t.out")
)

(allow authorization-right-obtain
    (right-name "com.apple.private.wifianalytics")
    (right-name "config.modify.com.apple.private.wifianalytics")
    (right-name "config.remove.com.apple.private.wifianalytics")
)

(allow process-exec
    (literal "/usr/local/bin/AWDTool")
    (literal "/usr/bin/killall")
    (literal "/usr/bin/leaks")
    (with no-sandbox)
)
