# https://github.com/emsec/ChameleonMini/issues/64
pu port             /dev/tty.usbmodem14201
pu localecho        Yes
pu linewrap         Yes
# disable other transports than xmodem
pu pname1           YUNYY
pu pname2           YUNYY
pu pname4           NDNYY
pu pname5           NDNYY
pu pname7           YUYNN
pu pname8           NDYNN
pu pname9           YUNYN
