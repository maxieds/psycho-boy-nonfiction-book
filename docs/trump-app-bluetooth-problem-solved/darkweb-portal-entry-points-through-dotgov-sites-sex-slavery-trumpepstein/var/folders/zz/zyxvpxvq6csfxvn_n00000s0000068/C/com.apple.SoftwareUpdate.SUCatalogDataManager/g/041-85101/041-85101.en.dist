<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion='1'>
    <options customize='never'/>
    <options hostArchitectures='i386,ppc'/>
    <options rootVolumeOnly='true'/>
    <platforms>
        <client arch='ppc,intel'/>
    </platforms>
    <title>SU_TITLE</title>
    <!-- manual outline -->
    <choices-outline>
        <line choice='manual_Canon_InkjetPrinterDrivers'/>
        <line choice='manual_Canon_InkjetProSeries'/>
    </choices-outline>
    <!-- end manual outline -->
    <!-- SU outline -->
    <choices-outline ui='SoftwareUpdate'>
        <line choice='auto'/>
    </choices-outline>
    <!-- end SU outline -->
    <!-- SU choice -->
    <choice id='auto' title='SU_TITLE' versStr='SU_VERS'/>
    <choice id='auto' description='SU_DESCRIPTION' description-mime-type='text/html'/>
    <choice id='auto' secondaryDescription='SU_DESC2'/>
    <choice id='auto' visible='true'/>
    <!-- end SU choice -->
    <!-- SU invis outline -->
    <choices-outline ui='invisible'>
        <line choice='invis_Canon_InkjetPrinterDrivers'/>
        <line choice='invis_Canon_InkjetProSeries'/>
        <line choice='invis_canon_dvd_all'/>
    </choices-outline>
    <!-- end SU invis outline -->
    <!-- SU invis Canon_InkjetProSeries choice -->
    <choice id='invis_Canon_InkjetProSeries' selected="!isInstalled() &amp;&amp; choices.auto.selected &amp;&amp; printerConnected(&quot;Canon_InkjetProSeries&quot;) &amp;&amp; driverNeedsUpdating(&quot;Canon_InkjetProSeries&quot;)"/>
    <choice id='invis_Canon_InkjetProSeries' suDisabledGroupID='Canon_InkjetProSeries'>
        <pkg-ref id='com.apple.pkg.Canon_InkjetProSeries' auth='Root'>Canon_InkjetProSeries.pkg</pkg-ref>
    </choice>
    <!-- end SU invis Canon_InkjetProSeries choice -->
    <!-- SU invis Canon_InkjetPrinterDrivers choice -->
    <choice id='invis_Canon_InkjetPrinterDrivers' selected="!isInstalled() &amp;&amp; choices.auto.selected &amp;&amp; printerConnected(&quot;Canon_InkjetPrinterDrivers&quot;) &amp;&amp; driverNeedsUpdating(&quot;Canon_InkjetPrinterDrivers&quot;)"/>
    <choice id='invis_Canon_InkjetPrinterDrivers' suDisabledGroupID='Canon_InkjetPrinterDrivers'>
        <pkg-ref id='com.apple.pkg.Canon_InkjetPrinterDrivers' auth='Root'>Canon_InkjetPrinterDrivers.pkg</pkg-ref>
    </choice>
    <!-- end SU invis Canon_InkjetPrinterDrivers choice -->
    <!-- SU manual Canon_InkjetProSeries choice -->
    <choice id='manual_Canon_InkjetProSeries' selected="!isInstalled() &amp;&amp; printerConnected(&quot;Canon_InkjetProSeries&quot;) &amp;&amp; driverNeedsUpdating(&quot;Canon_InkjetProSeries&quot;)"/>
    <choice id='manual_Canon_InkjetProSeries' suDisabledGroupID='Canon_InkjetProSeries'>
        <pkg-ref id='com.apple.pkg.Canon_InkjetProSeries.manual' auth='Root'>Canon_InkjetProSeries.pkg</pkg-ref>
    </choice>
    <!-- end SU manual Canon_InkjetProSeries choice -->
    <!-- SU manual Canon_InkjetPrinterDrivers choice -->
    <choice id='manual_Canon_InkjetPrinterDrivers' selected="!isInstalled() &amp;&amp; printerConnected(&quot;Canon_InkjetPrinterDrivers&quot;) &amp;&amp; driverNeedsUpdating(&quot;Canon_InkjetPrinterDrivers&quot;)"/>
    <choice id='manual_Canon_InkjetPrinterDrivers' suDisabledGroupID='Canon_InkjetPrinterDrivers'>
        <pkg-ref id='com.apple.pkg.Canon_InkjetPrinterDrivers.manual' auth='Root'>Canon_InkjetPrinterDrivers.pkg</pkg-ref>
    </choice>
    <!-- end SU manual Canon_InkjetPrinterDrivers choice -->
    <!-- invisible choice 1 -->
    <choice id='invis_canon_dvd_all' selected='false' visible='false'>
        <pkg-ref id='com.apple.pkg.CanonPrinterDrivers' auth='Root'>CanonPrinterDrivers.pkg</pkg-ref>
    </choice>
    <!-- end invisible choice 1 -->
    <volume-check script='VolumeCheck()'/>
    <script>
        <!-- printerIDs -->
        
		// ID Strings: printerIDs
		<!-- end printerIDs -->
        
            
        function VolumeCheck()
        {
            if (system.env.OS_INSTALL == 1) {
                return true;
            }
			
			if(system.files.fileExistsAtPath(my.target.mountpoint + "/var/db/.AppleTier3Language")) {
				my.result.type = 'Fatal';
            	my.result.message = system.localizedStandardString('GENERIC_FAIL_LANG');
				return false;
			}
			
      if(-1 == system.compareVersions(my.target.systemVersion.ProductVersion, '10.5.3')) {
				my.result.type = 'Fatal';
            	my.result.message = system.localizedStandardString('GENERIC_FAIL_VOLUME');
				return false;
			}
		  
			if(-1 != system.compareVersions(my.target.systemVersion.ProductVersion, '10.6.0')) {
				my.result.type = 'Fatal';
            	my.result.message = system.localizedStandardString('GENERIC_FAIL_VOLUME');
				return false;
			}
           
		   	if(! isNotDowngrade()) {
				my.result.type = 'Fatal';
            	my.result.message = system.localizedStandardString('GENERIC_FAIL_NEWER');
				return false;
			}
		    
			return true;
        }
				
		function isInstalled()
		{
		    var action = my.choice.packageUpgradeAction;
			if ((action == 'clean') || (action == 'upgrade')) {
				return false;
			}
			return true;
		}
		
    function isClean()
    {
		  var action = my.choice.packageUpgradeAction;
		  if (action != 'clean') {
				return false;
			}
			return true;
		}
	
		function isNotDowngrade()
		{
		    var action = my.choice.packageUpgradeAction;
			if ((action == 'mixed') || (action == 'downgrade')) {
				return false;
			}
			return true;
		}

    <!-- printerConnected -->
        
