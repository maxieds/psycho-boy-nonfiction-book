s","MANUFACTURER:Samsung;MODEL:Samsung M2020 Series","MANUFACTURER:Samsung;MODEL:M2070 Series","MANUFACTURER:Samsung;MODEL:Samsung M2070 Series","MANUFACTURER:Samsung;MODEL:CLX-3300 Series","MANUFACTURER:Samsung;MODEL:Samsung CLX-3300 Series","MANUFACTURER:Samsung;MODEL:C460 Series","MANUFACTURER:Samsung;MODEL:Samsung C460 Series","MANUFACTURER:Samsung;MODEL:CLP-410 Series","MANUFACTURER:Samsung;MODEL:Samsung CLP-410 Series","MANUFACTURER:Samsung;MODEL:CLX-4190 Series","MANUFACTURER:Samsung;MODEL:Samsung CLX-4190 Series","MANUFACTURER:Samsung;MODEL:M332x 382x 402x Series","MANUFACTURER:Samsung;MODEL:Samsung M332x 382x 402x Series","MANUFACTURER:Samsung;MODEL:M337x 387x 407x Series","MANUFACTURER:Samsung;MODEL:Samsung M337x 387x 407x Series","MANUFACTURER:Samsung;MODEL:CLX-8640 8650 Series","MANUFACTURER:Samsung;MODEL:Samsung CLX-8640 8650 Series","MANUFACTURER:Samsung;MODEL:Samsung CLX-8640 8650 Series PS","MANUFACTURER:Samsung;MODEL:CLP-775 Series","MANUFACTURER:Samsung;MODEL:Samsung CLP-775 Series","MANUFACTURER:Samsung;MODEL:Samsung CLP-775 Series PS"]; }
            else { possibleIDs = []; }
            
			// Debug for possible distribution merge error
			if (! possibleIDs.length) {
				return false;
			}

			var printerPlist = system.files.plistAtPath("/Library/Printers/InstalledPrinters.plist");
			if (printerPlist) {
				var installedIDs = printerPlist.InstalledPrinters;
				var matchingIDs = [];
				if (installedIDs) {	
					for (var i = 0; i &lt; installedIDs.length; i = i + 1) {
						for (var j = 0; j &lt; possibleIDs.length; j = j + 1) {
							if (installedIDs[i].toLowerCase() == possibleIDs[j].toLowerCase()) {
								matchingIDs.push(installedIDs[i]);
							}
						}
					}
					if (matchingIDs.length) {
						for (var i = 0; i &lt; matchingIDs.length; i = i + 1) {
							system.log("Connected printer: " + matchingIDs[i]);
						}
						return true;
					}
				}
			}
			
			return false;
		}
