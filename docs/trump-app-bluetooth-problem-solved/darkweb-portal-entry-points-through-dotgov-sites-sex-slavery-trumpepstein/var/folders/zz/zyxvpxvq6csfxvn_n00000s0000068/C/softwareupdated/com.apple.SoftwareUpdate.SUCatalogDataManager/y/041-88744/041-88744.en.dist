2460 series","MANUFACTURER:Brother;MODEL:HL-6050 series","MANUFACTURER:Brother;MODEL:HL-6050DN series","MANUFACTURER:Brother;MODEL:HL-6050D_DN series","MANUFACTURER:Brother;MODEL:HL-5240 series","MANUFACTURER:Brother;MODEL:HL-5250DN series","MANUFACTURER:Brother;MODEL:HL-5270DN series","MANUFACTURER:Brother;MODEL:HL-5280DW series","MANUFACTURER:Brother;MODEL:DCP-8060","MANUFACTURER:Brother;MODEL:DCP-8065DN","MANUFACTURER:Brother;MODEL:MFC-8460N","MANUFACTURER:Brother;MODEL:MFC-8660DN","MANUFACTURER:Brother;MODEL:MFC-8670DN","MANUFACTURER:Brother;MODEL:MFC-8860DN","MANUFACTURER:Brother;MODEL:MFC-8870DW","MANUFACTURER:Brother;MODEL:Brother HL-6050 BR-Script3","MANUFACTURER:Brother;MODEL:Brother HL-6050DN BR-Script3J","MANUFACTURER:Brother;MODEL:Brother HL-6050D/DN BR-Script3","MANUFACTURER:Brother;MODEL:HL-2030 series","MANUFACTURER:Brother;MODEL:HL-2040 series","MANUFACTURER:Brother;MODEL:HL-2070N series","MANUFACTURER:Brother;MODEL:MFC-7420","MANUFACTURER:Brother;MODEL:MFC-7820N","MANUFACTURER:Brother;MODEL:DCP-7010","MANUFACTURER:Brother;MODEL:DCP-7020","MANUFACTURER:Brother;MODEL:DCP-7025","MANUFACTURER:Brother;MODEL:MFC-7220","MANUFACTURER:Brother;MODEL:MFC-7225N","MANUFACTURER:Brother;MODEL:FAX-2820","MANUFACTURER:Brother;MODEL:FAX-2920","MANUFACTURER:Brother;MODEL:FAX-2810","MANUFACTURER:Brother;MODEL:FAX-2930","MANUFACTURER:Brother;MODEL:HL-2045 series","MANUFACTURER:Brother;MODEL:HL-2075N series"]}


        var printerPlist = system.files.plistAtPath("/Library/Printers/InstalledPrinters.plist");
        if (printerPlist) {
            var installedIDs = printerPlist.InstalledPrinters;
            if (installedIDs) {
                for (var i = 0; i &lt; installedIDs.length; i = i + 1) {
                    for (var j = 0; j &lt; removedIDs.length; j = j + 1) {
                        if (installedIDs[i].toLowerCase() == removedIDs[j].toLowerCase()) {
                            system.log("Package " + argv[0] + " contains installed removed printer id: " + removedIDs[j]);
                            return true;
                        }
                    }
                }
            }
        }
        return false;
    }
<!-- end packageWithRemovedIDs -->
        

    function isInstalled() {
        var action = my.choice.packageUpgradeAction;
        if ((action == 'clean') || (action == 'upgrade')) {
            return false;
        }
        return true;
    }
		
    function isClean()
    {
		  var action = my.choice.packageUpgradeAction;
		  if (action != 'clean') {
				return false;
			}
			return true;
		}
	
		function isNotDowngrade()
		{
		    var action = my.choice.packageUpgradeAction;
			if ((action == 'mixed') || (action == 'downgrade')) {
				return false;
			}
			return true;
		}

    <!-- printerConnectedAndNeedsUpdate -->
        
		function printerConnectedAndNeedsUpdate()
		{
			var printers = ["Brother_MonochromeLaser","Brother_SInk","Brother_Ptouch","Brother_Inkjet12","Brother_Inkjet08Common","Brother_Utility","Brother_Inkjet10","Brother_Common","Brother_Inkjet14","Brother_Inkjet15","Brother_Inkjet09","Brother_Inkjet13v2","Brother_ColorLaser","Brother_ICA","Brother_ColorLaser2","Brother_Inkjet08","Brother_Inkjet10Common","Brother_Inkjet11","Brother_Inkjet13","Brother_Help"];
			
			for(var i=0;i &lt; printers.length; i=i+1)
			{
				if (printerConnected(printers[i]) &amp;&amp; driverNeedsUpdating(printers[i]))
				{
					return true;
				}
			}	
			return false;
		}
    <!-- end printerConnectedAndNeedsUpdate  -->
        <!-- printerConnected -->
        
		function printerConnected()
		{
			var argv = printerConnected.arguments;
			
