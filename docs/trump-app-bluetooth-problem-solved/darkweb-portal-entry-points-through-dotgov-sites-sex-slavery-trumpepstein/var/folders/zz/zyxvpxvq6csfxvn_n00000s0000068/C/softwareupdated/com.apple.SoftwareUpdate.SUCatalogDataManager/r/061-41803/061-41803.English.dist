        <pkg-ref id="FirmwareUpdate" auth="Root" packageIdentifier="com.apple.pkg.FirmwareUpdate">FirmwareUpdate.pkg</pkg-ref>
        <pkg-ref id="FullBundleUpdate" auth="Root" packageIdentifier="com.apple.update.fullbundleupdate.16G2136">FullBundleUpdate.pkg</pkg-ref>
