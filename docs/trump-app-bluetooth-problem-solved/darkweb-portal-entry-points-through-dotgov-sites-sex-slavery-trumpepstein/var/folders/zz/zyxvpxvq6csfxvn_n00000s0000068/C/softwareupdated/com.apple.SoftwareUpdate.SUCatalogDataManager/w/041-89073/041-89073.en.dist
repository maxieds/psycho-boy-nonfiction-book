        <!-- printerConnected -->
        
		function printerConnected()
		{
			var argv = printerConnected.arguments;
			
			var possibleIDs = [];
			
			if (argv.length == 0 || argv[0] == 'all') { possibleIDs = []; }
			else if (argv[0] == 'EPSON_DriverCommon058') { possibleIDs = ["MANUFACTURER:EPSON;MODEL:PM-A940","MANUFACTURER:EPSON;MODEL:PM-T960","MANUFACTURER:EPSON;MODEL:EPSON PM-A940","MANUFACTURER:EPSON;MODEL:EPSON PM-T960",]; }
			else if (argv[0] == 'EPSON_DriverCommon380') { possibleIDs = ["MANUFACTURER:EPSON;MODEL:EP-10VA Series","MANUFACTURER:EPSON;MODEL:EPSON EP-10VA Series",]; }
			else if (argv[0] == 'EPSON_DriverCommon335') { possibleIDs = ["MANUFACTURER:EPSON;MODEL:WF-100 Series","MANUFACTURER:EPSON;MODEL:EPSON WF-100 Series","MANUFACTURER:EPSON;MODEL:PX-S05 Series","MANUFACTURER:EPSON;MODEL:EPSON PX-S05 Series",]; }
