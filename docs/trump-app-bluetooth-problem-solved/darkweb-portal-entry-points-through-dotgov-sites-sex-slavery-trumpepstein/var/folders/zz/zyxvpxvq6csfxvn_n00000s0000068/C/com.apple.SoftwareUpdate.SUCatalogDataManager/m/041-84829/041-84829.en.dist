    <choices-outline ui='invisible'>
        <line choice='invis_Infotec_Drivers'/>
        <line choice='invis_makequeues_all'/>
    </choices-outline>
    <!-- end SU invis outline -->
    <!-- SU invis Infotec_Drivers choice -->
    <choice id='invis_Infotec_Drivers' selected="!packageBlockedByRemovedID(&quot;Infotec_Drivers&quot;) &amp;&amp; !isInstalled() &amp;&amp; printerConnected(&quot;Infotec_Drivers&quot;) &amp;&amp; driverNeedsUpdating(&quot;Infotec_Drivers&quot;)"/>
    <choice id='invis_Infotec_Drivers' suDisabledGroupID='Infotec_Drivers'>
        <pkg-ref id='com.apple.pkg.Infotec_Drivers' auth='Root'>Infotec_Drivers.pkg</pkg-ref>
    </choice>
    <!-- end SU invis Infotec_Drivers choice -->
    <!-- SU manual Infotec_Drivers choice -->
    <choice id='manual_Infotec_Drivers' selected="!packageBlockedByRemovedID(&quot;Infotec_Drivers&quot;) &amp;&amp; !isInstalled() &amp;&amp; printerConnected(&quot;Infotec_Drivers&quot;) &amp;&amp; driverNeedsUpdating(&quot;Infotec_Drivers&quot;)"/>
    <choice id='manual_Infotec_Drivers' suDisabledGroupID='Infotec_Drivers'>
        <pkg-ref id='com.apple.pkg.Infotec_Drivers.manual' auth='Root'>#Infotec_Drivers.pkg</pkg-ref>
