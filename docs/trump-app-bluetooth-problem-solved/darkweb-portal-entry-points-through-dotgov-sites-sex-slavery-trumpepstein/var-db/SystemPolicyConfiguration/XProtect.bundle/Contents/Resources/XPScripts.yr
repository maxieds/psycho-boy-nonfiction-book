private rule OSACompiled
{
    meta:
        description = "MACOS.OSASCRIPT.OSACOMPILED"
        uuid = "ED28BE44-6F07-4847-ACFC-A13E25949235"
        interpreter = "osascript"

    strings:
        $header_applescript = "FasdUAS"
        $header_javascript = "JsOsaDAS"
        $trailer = { FA DE DE AD }
    condition:
        ($header_applescript at 0 or $header_javascript at 0) and $trailer at (filesize - 4)
}

rule XProtect_MACOS_OSASCRIPT_COTABR {
    meta:
        description = "MACOS.OSASCRIPT.COTABR"
        uuid = "FAA3D768-953A-4B4F-9EAA-7E967BD38196"
        interpreter = "osascript"
        match_type = 4

    strings:
        $a0 = "Chromium" nocase
        $a1 = "Microsoft Edge" nocase
        $a2 = "Chrome" nocase
        $a3 = "Opera" nocase
        $a4 = "Brave" nocase
        $a5 = "Chrome Beta" nocase
        $a6 = "Chrome Canary" nocase
        $a7 = "FireFox" nocase
        $a8 = "WaterFox" nocase
        $a9 = "Vivaldi" nocase
        $a10 = "Cookies.binarycookies" nocase
        $a11 = "Safari" nocase
        $a12 = "Brave-Browser" nocase
        $a13 = "Chrome Dev" nocase
        $a14 = "Edge" nocase

    condition:
        all of them and filesize < 1MB
}


