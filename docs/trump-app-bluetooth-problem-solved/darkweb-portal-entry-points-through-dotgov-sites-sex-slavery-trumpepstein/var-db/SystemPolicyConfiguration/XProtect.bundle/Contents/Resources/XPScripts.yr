rule XProtect_MACOS_OSASCRIPT_TIPEAP {
    meta:
        description = "MACOS.OSASCRIPT.TIPEAP"
        uuid = "44949A48-E76C-4D0E-9B7F-307C74E6C42C"
        interpreter = "osascript"

    strings:
        $a1 = "do shell script \"cp -R \" & quoted form of TREZORPATH" nocase wide ascii
        $a2 = "set TREZORNAME to \"Trezor Suite.app\"" nocase wide ascii
        $a3 = "set TREZORAPPFOLDER to \"/Applications\"" nocase wide ascii
        $a4 = "do shell script \"killall -9 'Trezor Suite'\"" nocase wide ascii
        $b1 = "do shell script /\"cp -rf /\" & quoted form of LEDGERDEST" nocase wide ascii
        $b2 = "set LEDGERAPPFOLDER to \"/Applications\"" nocase wide ascii
        $b3 = "set LEDGERTMPDEST to \"/tmp/Ledger Wallet.app\"" nocase wide ascii
        $b4 = "set ledger_installed to true" nocase wide ascii

    condition:
        all of ( $a* ) or all of ( $b* )
}

