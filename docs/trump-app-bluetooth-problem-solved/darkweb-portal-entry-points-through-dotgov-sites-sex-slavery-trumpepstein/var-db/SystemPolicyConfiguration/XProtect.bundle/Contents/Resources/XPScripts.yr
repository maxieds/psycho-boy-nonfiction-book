        $a8 = "buildHash" ascii wide nocase
        $a9 = "=== SCRIPT COMPLETE ===" ascii wide nocase
        $b1 = "Hostname" ascii wide nocase
        $b2 = "CIS" ascii wide nocase
        $b3 = "IP" ascii wide nocase
        $b4 = "Locale" ascii wide nocase
        $b5 = "Chromium: starting" ascii wide nocase
        $b6 = "ChromumWallets: starting" ascii wide nocase
        $b7 = "Telegram: starting" ascii wide nocase
        $b8 = "DesktopWallets: starting" ascii wide nocase
        $b9 = "Persistence: script" ascii wide nocase
        $b10 = "Persistence: plist" ascii wide nocase
        $b11 = "Persistence: OK" ascii wide nocase
        $c1 = "SHub Stealer (DEBUG)" ascii wide nocase

    condition:
        4 of ( $a* ) and 4 of ( $b* ) and $c1
}

