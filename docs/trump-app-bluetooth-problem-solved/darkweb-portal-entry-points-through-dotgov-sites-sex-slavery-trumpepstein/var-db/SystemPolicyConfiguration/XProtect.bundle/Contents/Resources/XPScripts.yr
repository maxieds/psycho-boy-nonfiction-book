rule XProtect_MACOS_OSASCRIPT_SYPR {
    meta:
        description = "MACOS.OSASCRIPT.SYPR"
        uuid = "B6700568-B9C5-40C3-B01E-03A2E1BC7333"
        interpreter = "osascript"

    strings:
        $b1 = "giving up after 150 with title" nocase wide ascii
        $b2 = "CloudFlare Security Verification Required" nocase wide ascii
        $b3 = "Required Application Helper" nocase wide ascii
        $b4 = "Application wants to install helper" nocase wide ascii
        $b5 = "macOS needs to access System Settings" nocase wide ascii
        $b6 = "You need to configure system settings before running this application" nocase wide ascii
        $b7 = "with title \"System Preferences" nocase wide ascii
        $b8 = "Your Mac does not support this application" nocase wide ascii
        $b9 = "Try reinstalling or downloading the version for your system" nocase wide ascii
        $b10 = "You need to configure system settings before running this application" nocase wide ascii
        $b11 = "System Preferences wants to make changes" ascii wide nocase
        $b12 = "You should update the settings to launch the application" ascii wide nocase
        $b13 = "The current version of the app is not fully compatible with your version of MacOS" nocase wide ascii
        $a1 = "Please enter password for continue" nocase wide ascii
        $a2 = "Please enter the device password to continue" nocase wide ascii
        $a3 = "Please enter your password" nocase wide ascii
        $a4 = "Please enter device password to continue" ascii wide nocase
        $a5 = "Type your password to do this" ascii wide nocase
        $a6 = "For the app to work correctly please, enter password of your system" ascii wide nocase
        $a7 = "please, enter password of your system" ascii wide nocase
        $c1 = "with hidden answer" nocase wide ascii

    condition:
        1 of ( $a* ) and 2 of ( $b* ) and all of ( $c* ) and filesize < 1MB
}

