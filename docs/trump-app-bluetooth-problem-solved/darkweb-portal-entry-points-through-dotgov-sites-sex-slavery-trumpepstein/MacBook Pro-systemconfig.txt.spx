						<string>Avenir</string>
						<key>fullname</key>
						<string>Avenir Book</string>
						<key>outline</key>
						<string>yes</string>
						<key>style</key>
						<string>Book</string>
						<key>trademark</key>
						<string>Avenir is a trademark of Heidelberger Druckmaschinen AG, exclusively licensed through Linotype GmbH, and may be registered in certain jurisdictions.</string>
						<key>unique</key>
