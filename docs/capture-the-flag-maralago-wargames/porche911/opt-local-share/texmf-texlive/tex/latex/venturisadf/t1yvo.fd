\ProvidesFile{t1yvo.fd}
   [2024/08/17 Fontinst v1.933 font definitions for T1/yvo.]

% addaswyd o t1phv.fd (dyddiad y ffeil fd: 2020-03-25)
\expandafter\ifx\csname yvo@scale\endcsname\relax
  \let\yvo@@scale\@empty
\else
  \edef\yvo@@scale{s*[\csname yvo@scale\endcsname]}%
\fi

\DeclareFontFamily{T1}{yvo}{}

\DeclareFontShape{T1}{yvo}{m}{n}{
   <-> \yvo@@scale yvor8t
}{}

\DeclareFontShape{T1}{yvo}{m}{it}{
   <-> \yvo@@scale yvori8t
}{}

\DeclareFontShape{T1}{yvo}{b}{n}{
   <-> \yvo@@scale yvob8t
}{}

\DeclareFontShape{T1}{yvo}{b}{it}{
   <-> \yvo@@scale yvobi8t
}{}

\DeclareFontShape{T1}{yvo}{m}{sc}{<->sub * yvo/m/n}{}
\DeclareFontShape{T1}{yvo}{m}{scit}{<->ssub * yvo/m/sc}{}
\DeclareFontShape{T1}{yvo}{m}{scsl}{<->ssub * yvo/m/scit}{}
\DeclareFontShape{T1}{yvo}{m}{si}{<->ssub * yvo/m/scsl}{}
\DeclareFontShape{T1}{yvo}{m}{sl}{<->ssub * yvo/m/it}{}
\DeclareFontShape{T1}{yvo}{bx}{n}{<->ssub * yvo/b/n}{}
\DeclareFontShape{T1}{yvo}{b}{sc}{<->sub * yvo/b/n}{}
\DeclareFontShape{T1}{yvo}{bx}{sc}{<->ssub * yvo/b/sc}{}
\DeclareFontShape{T1}{yvo}{b}{scit}{<->ssub * yvo/b/sc}{}
\DeclareFontShape{T1}{yvo}{bx}{scit}{<->ssub * yvo/b/scit}{}
\DeclareFontShape{T1}{yvo}{b}{scsl}{<->ssub * yvo/b/scit}{}
\DeclareFontShape{T1}{yvo}{bx}{scsl}{<->ssub * yvo/b/scsl}{}
\DeclareFontShape{T1}{yvo}{b}{si}{<->ssub * yvo/b/scsl}{}
\DeclareFontShape{T1}{yvo}{bx}{si}{<->ssub * yvo/b/si}{}
\DeclareFontShape{T1}{yvo}{bx}{it}{<->ssub * yvo/b/it}{}
\DeclareFontShape{T1}{yvo}{b}{sl}{<->ssub * yvo/b/it}{}
\DeclareFontShape{T1}{yvo}{bx}{sl}{<->ssub * yvo/b/sl}{}

\endinput
