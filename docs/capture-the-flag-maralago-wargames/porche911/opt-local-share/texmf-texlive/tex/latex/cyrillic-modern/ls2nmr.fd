%%%%%%% bold series
\DeclareFontShape{LS2}{nmr}{b}{n}
     {%
      <5><6><7><8><9><10><10.95><12>%
      <14.4><17.28><20.74><24.88>ls2-nmb10%
      }{}
%%%%%%%% bold extended series
\DeclareFontShape{LS2}{nmr}{bx}{n}
   {%
      <5><6><7><8><9>gen*ls2-nmbx%
      <10><10.95>ls2-nmbx10%
      <12><14.4><17.28><20.74><24.88>ls2-nmbx12%
      }{}
\DeclareFontShape{LS2}{nmr}{bx}{sl}
      {%
      <5><6><7><8><9>%
      <10><10.95><12><14.4><17.28><20.74><24.88>ls2-nmbxsl10%
      }{}
\DeclareFontShape{LS2}{nmr}{bx}{it}
       {%
       <5><6><7><8><9>%
       <10><10.95><12><14.4><17.28><20.74><24.88>ls2-nmbxti10%
       }{}
