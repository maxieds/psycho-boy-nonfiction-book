\ProvidesFile{ls2nmr.fd}
        [2014/12/22 Cyrillic Modern font definitions]
%\DeclareFontEncoding{LS2}{}{}
%\DeclareFontSubstitution{LS2}{cmr}{m}{n}
\DeclareFontFamily{LS2}{nmr}{}
\DeclareFontShape{LS2}{nmr}{m}{n}%
     {<5><6><7><8><9><10><12>gen*ls2-nmr%
      <10.95>ls2-nmr10%
      <14.4>ls2-nmr12%
      <17.28><20.74><24.88>ls2-nmr17}{}
\DeclareFontShape{LS2}{nmr}{m}{sl}%
     {%
      <5><6><7>ls2-nmsl8%
      <8><9>gen*ls2-nmsl%
      <10><10.95>ls2-nmsl10%
      <12><14.4><17.28><20.74><24.88>ls2-nmsl12%
      }{}
\DeclareFontShape{LS2}{nmr}{m}{it}%
     {%
      <5><6><7>ls2-nmti7%
      <8>ls2-nmti8%
      <9>ls2-nmti9%
      <10><10.95>ls2-nmti10%
      <12><14.4><17.28><20.74><24.88>ls2-nmti12%
      }{}
\DeclareFontShape{LS2}{nmr}{m}{sc}%
     {%
      <5><6><7><8><9><10><10.95><12>%
      <14.4><17.28><20.74><24.88>ls2-nmcsc10%
      }{}
% Warning: please note that the upright shape below is
%          used for the \pounds symbol of LaTeX. So this
%          font definition shouldn't be removed.
%
