\ProvidesPackage{nm}
        [2014/12/22 Cyrillic Modern font definitions]
\renewcommand{\rmdefault}{nmr}
\renewcommand{\sfdefault}{nmss}

%\DeclareFontEncoding{T2A}{}{}
%\DeclareFontSubstitution{T2A}{cmr}{m}{n}
\DeclareTextSymbol{\flqq}{\LastDeclaredEncoding}{190}
\DeclareTextSymbol{\frqq}{\LastDeclaredEncoding}{191}
%\DeclareUnicodeCharacter{20BD}{\ruble}

\SetSymbolFont{operators}{normal}{OT1}{nmr}{m}{n}
\SetSymbolFont{letters}{normal}{OML}{nmm}{m}{it}
\SetSymbolFont{operators}{bold}{OT1}{nmr}{bx}{n}
\SetSymbolFont{letters}{bold}{OML}{nmm}{b}{it}

\SetMathAlphabet{\mathbf}{normal}{OT1}{nmr}{bx}{n}
\SetMathAlphabet{\mathsf}{normal}{OT1}{nmss}{m}{n}
\SetMathAlphabet{\mathit}{normal}{OT1}{nmr}{m}{it}
%\SetMathAlphabet{\mathtt}{normal}{OT1}{nmtt}{m}{n}
\SetMathAlphabet{\mathbf}{bold}{OT1}{nmr}{bx}{n}
\SetMathAlphabet{\mathsf}{bold}{OT1}{nmss}{bx}{n}
\SetMathAlphabet{\mathit}{bold}{OT1}{nmr}{bx}{it}
%\SetMathAlphabet{\mathtt}{bold}{OT1}{nmtt}{m}{n}

\ProvideTextCommand{\ruble}{T2A}{{\fontencoding{LS2}\selectfont\char82}}
\ProvideTextCommand{\ellipsis}{T2A}{{\fontencoding{LS2}\selectfont\char46}}

\input{ls2enc.def}

\endinput
