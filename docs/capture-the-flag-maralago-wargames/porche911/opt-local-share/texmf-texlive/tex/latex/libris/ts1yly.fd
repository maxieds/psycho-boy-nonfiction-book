\DeclareFontShape{TS1}{yly}{m}{si}{<->ssub * yly/m/scit}{}
\DeclareFontShape{TS1}{yly}{bx}{n}{<->ssub * yly/b/n}{}
\DeclareFontShape{TS1}{yly}{b}{sc}{<->ssub * yly/b/n}{}
\DeclareFontShape{TS1}{yly}{bx}{sc}{<->ssub * yly/b/sc}{}
\DeclareFontShape{TS1}{yly}{bx}{it}{<->ssub * yly/b/it}{}
\DeclareFontShape{TS1}{yly}{b}{sl}{<->ssub * yly/b/it}{}
\DeclareFontShape{TS1}{yly}{bx}{sl}{<->ssub * yly/b/sl}{}
\DeclareFontShape{TS1}{yly}{b}{scsl}{<->ssub * yly/b/sl}{}
\DeclareFontShape{TS1}{yly}{bx}{scsl}{<->ssub * yly/b/scsl}{}
\DeclareFontShape{TS1}{yly}{b}{scit}{<->ssub * yly/b/scsl}{}
\DeclareFontShape{TS1}{yly}{bx}{scit}{<->ssub * yly/b/scit}{}
\DeclareFontShape{TS1}{yly}{b}{si}{<->ssub * yly/b/scit}{}
\DeclareFontShape{TS1}{yly}{bx}{si}{<->ssub * yly/b/si}{}

