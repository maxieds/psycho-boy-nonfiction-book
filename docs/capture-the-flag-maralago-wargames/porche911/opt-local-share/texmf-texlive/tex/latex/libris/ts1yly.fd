% addaswyd o t1phv.fd (dyddiad y ffeil fd: 2020-03-25)
\expandafter\ifx\csname yly@scale\endcsname\relax
  \let\yly@@scale\@empty
\else
  \edef\yly@@scale{s*[\csname yly@scale\endcsname]}%
\fi

\DeclareFontFamily{TS1}{yly}{}

\DeclareFontShape{TS1}{yly}{m}{n}{
   <-> \yly@@scale ylyr8c
}{}

\DeclareFontShape{TS1}{yly}{m}{it}{
   <-> \yly@@scale ylyri8c
}{}

\DeclareFontShape{TS1}{yly}{b}{n}{
   <-> \yly@@scale ylyb8c
}{}

\DeclareFontShape{TS1}{yly}{b}{it}{
   <-> \yly@@scale ylybi8c
}{}

\DeclareFontShape{TS1}{yly}{m}{sc}{<->ssub * yly/m/n}{}
