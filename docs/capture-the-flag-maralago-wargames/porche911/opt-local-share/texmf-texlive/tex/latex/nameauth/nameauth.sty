      \ifx\@nameauth@Ai\@empty
        \ifx\@nameauth@Si\@empty
          \IndexRef[#4]{#5}[#6]{\@nameauth@Bi}%
        \else
          \IndexRef[#4]{#5}[#6]
          {\@nameauth@Bi\@nameauth@space\@nameauth@Si}%
        \fi
      \else
        \ifx\@nameauth@Si\@empty
          \IndexRef[#4]{#5}[#6]
          {\@nameauth@Bi,\@nameauth@space\@nameauth@Ai}%
        \else
          \IndexRef[#4]{#5}[#6]
