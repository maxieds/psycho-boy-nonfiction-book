\newtoks\xpnct@tok
\def\xpnct@aux#1#2{%
  \xpnct@tok{#2}%
  \futurelet\xpnct@nxt#1}
\def\xspace@aux{%
  \ifx\xpnct@nxt,\else
  \ifx\xpnct@nxt.\else
    \xpnct@tok\expandafter{\the\xpnct@tok\xspace}%
  \fi\fi
  \the\xpnct@tok}
\def\xperiod@aux{%
  \ifx\xpnct@nxt.\else
    \xpnct@tok\expandafter{\the\xpnct@tok.\@\xspace}%
  \fi
  \the\xpnct@tok}
\def\xcomma@aux{%
  \ifx\xpnct@nxt.\else
  \ifx\xpnct@nxt,\else
