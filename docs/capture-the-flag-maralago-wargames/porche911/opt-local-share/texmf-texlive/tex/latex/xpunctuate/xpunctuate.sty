  \ifx\xpnct@nxt\/\else
    \xpnct@tok\expandafter{\the\xpnct@tok,\xspace}%
  \fi\fi\fi\fi\fi\fi\fi\fi\fi\fi\fi\fi\fi\fi
  \the\xpnct@tok}
\def\xperiodcomma@aux{%
