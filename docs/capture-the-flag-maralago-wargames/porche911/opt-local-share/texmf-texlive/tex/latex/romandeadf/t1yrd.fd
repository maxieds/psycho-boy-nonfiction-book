\ProvidesFile{t1yrd.fd}
   [2024/08/12 Fontinst v1.933 font definitions for T1/yrd.]

% addaswyd o t1phv.fd (dyddiad y ffeil fd: 2020-03-25)
\expandafter\ifx\csname yrd@scale\endcsname\relax
  \let\yrd@@scale\@empty
\else
  \edef\yrd@@scale{s*[\csname yrd@scale\endcsname]}%
\fi

\DeclareFontFamily{T1}{yrd}{}

\DeclareFontShape{T1}{yrd}{m}{n}{
   <-> \yrd@@scale yrdr8t
}{}

\DeclareFontShape{T1}{yrd}{m}{sc}{
   <-> \yrd@@scale yrdrc8t
}{}

\DeclareFontShape{T1}{yrd}{m}{it}{
   <-> \yrd@@scale yrdri8t
}{}

\DeclareFontShape{T1}{yrd}{m}{sl}{
   <-> \yrd@@scale yrdri8t
}{}

\DeclareFontShape{T1}{yrd}{db}{n}{
   <-> \yrd@@scale yrdd8t
}{}

\DeclareFontShape{T1}{yrd}{db}{sc}{
   <-> \yrd@@scale yrddc8t
}{}

\DeclareFontShape{T1}{yrd}{db}{it}{
   <-> \yrd@@scale yrddi8t
}{}

\DeclareFontShape{T1}{yrd}{db}{sl}{
   <-> \yrd@@scale yrddi8t
}{}

\DeclareFontShape{T1}{yrd}{m}{scit}{<->ssub * yrd/m/sc}{}
\DeclareFontShape{T1}{yrd}{db}{scit}{<->ssub * yrd/m/scit}{}
\DeclareFontShape{T1}{yrd}{b}{scit}{<->ssub * yrd/db/scit}{}
\DeclareFontShape{T1}{yrd}{bx}{scit}{<->ssub * yrd/b/scit}{}
\DeclareFontShape{T1}{yrd}{m}{scsl}{<->ssub * yrd/m/scit}{}
\DeclareFontShape{T1}{yrd}{db}{scsl}{<->ssub * yrd/m/scsl}{}
\DeclareFontShape{T1}{yrd}{b}{scsl}{<->ssub * yrd/db/scsl}{}
\DeclareFontShape{T1}{yrd}{bx}{scsl}{<->ssub * yrd/b/scsl}{}
\DeclareFontShape{T1}{yrd}{m}{si}{<->ssub * yrd/m/scsl}{}
\DeclareFontShape{T1}{yrd}{db}{si}{<->ssub * yrd/m/si}{}
\DeclareFontShape{T1}{yrd}{b}{si}{<->ssub * yrd/db/si}{}
\DeclareFontShape{T1}{yrd}{bx}{si}{<->ssub * yrd/b/si}{}
\DeclareFontShape{T1}{yrd}{b}{n}{<->ssub * yrd/db/n}{}
\DeclareFontShape{T1}{yrd}{bx}{n}{<->ssub * yrd/b/n}{}
\DeclareFontShape{T1}{yrd}{b}{sc}{<->ssub * yrd/db/sc}{}
\DeclareFontShape{T1}{yrd}{bx}{sc}{<->ssub * yrd/b/sc}{}
\DeclareFontShape{T1}{yrd}{b}{it}{<->ssub * yrd/db/it}{}
\DeclareFontShape{T1}{yrd}{bx}{it}{<->ssub * yrd/b/it}{}
\DeclareFontShape{T1}{yrd}{b}{sl}{<->ssub * yrd/db/sl}{}
\DeclareFontShape{T1}{yrd}{bx}{sl}{<->ssub * yrd/b/sl}{}

\endinput
