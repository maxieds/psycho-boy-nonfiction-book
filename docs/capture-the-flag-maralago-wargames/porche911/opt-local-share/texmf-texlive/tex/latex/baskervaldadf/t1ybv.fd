% addaswyd o t1phv.fd (dyddiad y ffeil fd: 2020-03-25)
\expandafter\ifx\csname ybv@scale\endcsname\relax
  \let\ybv@@scale\@empty
\else
  \edef\ybv@@scale{s*[\csname ybv@scale\endcsname]}%
\fi

\DeclareFontFamily{T1}{ybv}{}

\DeclareFontShape{T1}{ybv}{m}{n}{
   <-> \ybv@@scale ybvr8t
}{}

\DeclareFontShape{T1}{ybv}{m}{it}{
   <-> \ybv@@scale ybvri8t
}{}

\DeclareFontShape{T1}{ybv}{b}{n}{
   <-> \ybv@@scale ybvb8t
}{}

\DeclareFontShape{T1}{ybv}{b}{it}{
   <-> \ybv@@scale ybvbi8t
}{}

\DeclareFontShape{T1}{ybv}{eb}{n}{
   <-> \ybv@@scale ybvh8t
}{}

\DeclareFontShape{T1}{ybv}{eb}{sl}{
   <-> \ybv@@scale ybvho8t
}{}

\DeclareFontShape{T1}{ybv}{m}{sc}{<->ssub * ybv/m/n}{}
\DeclareFontShape{T1}{ybv}{m}{sl}{<->ssub * ybv/m/it}{}
\DeclareFontShape{T1}{ybv}{bx}{n}{<->ssub * ybv/b/n}{}
\DeclareFontShape{T1}{ybv}{b}{sc}{<->ssub * ybv/b/n}{}
\DeclareFontShape{T1}{ybv}{bx}{sc}{<->ssub * ybv/b/sc}{}
\DeclareFontShape{T1}{ybv}{bx}{it}{<->ssub * ybv/b/it}{}
\DeclareFontShape{T1}{ybv}{b}{sl}{<->ssub * ybv/b/it}{}
\DeclareFontShape{T1}{ybv}{bx}{sl}{<->ssub * ybv/b/sl}{}
\DeclareFontShape{T1}{ybv}{eb}{sc}{<->ssub * ybv/eb/n}{}
\DeclareFontShape{T1}{ybv}{eb}{it}{<->ssub * ybv/eb/sl}{}

