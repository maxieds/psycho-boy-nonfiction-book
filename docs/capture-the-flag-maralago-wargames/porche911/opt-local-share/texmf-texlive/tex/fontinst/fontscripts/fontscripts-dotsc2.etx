\relax

\encoding

\setcommand\lc#1#2{#2.sc}
\setcommand\uc#1#2{#1}
\setcommand\lctop#1#2{#2.sc}
\setcommand\uctop#1#2{#1}
\setcommand\lclig#1#2{#2.sc}
\setcommand\uclig#1#2{#1spaced}

\ifisint{capspacing}\then
   \setint{letterspacing}{\int{capspacing}}
\fi

\endencoding
\endinput
