// Helper function to map conference types to human-readable session types
function mapConferenceType(conferenceTypes, contentType, strings) {
	if (!conferenceTypes || conferenceTypes.length === 0) return "Unknown";

	const type = conferenceTypes[0];

	// Check if it's a consultation (appointment)
	if (contentType === "consultation") {
		return type === "inperson" ? strings.inPersonAppointment : strings.onlineAppointment;
	}

	// Map other types
	switch (type) {
		case "inperson":
			return strings.inPersonSession;
		case "webex":
		case "eventURL":
			return strings.onlineSession;
		default:
			return strings.session;
	}
}

// Helper function to map language codes to human-readable names
function mapLanguage(languageCode, strings) {
	return strings.languages[languageCode] || languageCode;
}

// Extract and format event details
function extractEventDetails(event, locale = "en", strings) {
	// Try to get localized name with fallback chain:
	// 1. Requested locale, 2. English, 3. Event's delivery language, 4. First available
	let name =
		event.localizations[locale]?.name ||
		event.localizations.en?.name ||
		event.localizations[event.deliveryLanguage]?.name ||
		Object.values(event.localizations)[0]?.name ||
		"Unnamed Event";

	// Get content type from first content item
	const contentType = event.contents?.[0]?.type || "presentation";

	return {
		id: event.id,
		name: name,
		startDate: event.startDate,
		endDate: event.endDate,
		sessionType: mapConferenceType(event.conferenceTypes, contentType, strings),
		locationName: event.location?.name || "",
		locationCity: event.location?.city || "",
		language: mapLanguage(event.deliveryLanguage, strings),
		link: `/events/view/${event.id}/dashboard`,
	};
}

// Generate HTML for an event card
function generateEventCard(details, locale = "en") {
	const formattedDate = formatEventDate(details.startDate, details.endDate, locale);

	return `
		<li role="listitem" class="sc-gallery__item">
			<a href="${details.link}" class="sc-gallery__card tile tile-rounded tile-full">
				<div class="tile-content text-left">
					<div>
						<h5>${details.name}</h5>
						<p class="smaller event-details-a">${formattedDate}</p>
						<p class="smaller margin-top-small event-details-b">${details.sessionType}<br>${
							details.locationName
						}${details.locationCity ? ", " + details.locationCity : ""}<br>${details.language}</p>
					</div>
				</div>
			</a>
		</li>
	`;
}

// Fetch dummy events from JSON file
async function fetchDummyEvents() {
	try {
		const response = await fetch("/design/scripts/eventData.json");
		if (!response.ok) {
			throw new Error(`Failed to load dummy data: ${response.status}`);
		}
		const data = await response.json();
		return data.events || [];
	} catch (error) {
		console.error("Error loading dummy events:", error);
		return [];
	}
}

async function fetchUpcomingEvents() {
	// Check if dummy data mode is enabled
	if (useLoremData()) {
		return await fetchDummyEvents();
	}

	// Otherwise, fetch from the real API
	const startDate = new Date().toISOString().replace(/\.\d{3}Z$/, "Z");
	const endDate = "2030-01-01T00:00:00Z";

	const body = {
		filters: [
			{
				field: "eventDate",
				type: "date",
				arguments: [startDate, endDate],
			},
		],
		pageNumber: 1,
		pageSize: 10,
		sort: [
			{
				field: "startDate",
				order: "ASC",
			},
		],
	};

	try {
		const response = await fetch("/services-public/event/developer/eventList", {
			method: "POST",
			headers: {
				"Content-Type": "application/json",
			},
			body: JSON.stringify(body),
		});

		if (!response.ok) {
			const errorText = await response.text();
			throw new Error(`Request failed with status ${response.status}: ${errorText}`);
		}

		const data = await response.json();
		return data.events || [];
	} catch (error) {
		console.error("Error fetching events:", error);
		return [];
	}
}

// Populate the gallery with event data
function populateEventGallery(events, locale, strings) {
	const gallery = document.querySelector("#gallery-1");
	if (!gallery) {
		console.error("Gallery container not found");
		return;
	}

	const cardSet = gallery.querySelector(".sc-gallery__card-set");
	if (!cardSet) {
		console.error("Card set container not found");
		return;
	}

	// Generate HTML for all events
	const eventsHTML = events
		.map((event) => {
			const details = extractEventDetails(event, locale, strings);
			return generateEventCard(details, locale);
		})
		.join("");

	// Replace skeleton cards with real event cards
	cardSet.innerHTML = eventsHTML;

	// Mark loading as complete
	gallery.setAttribute("data-loading", "false");

	// Re-initialize the gallery after content is loaded
	// Remove the initialized flag so it can be re-initialized
	gallery.removeAttribute("data-gallery-initialized");

	// Dispatch a custom event to trigger re-initialization
	window.dispatchEvent(new CustomEvent("galleryContentUpdated"));
}

(async () => {
	const locale = getPageLocale();
	const strings = getLocalizedStrings(locale);

	const events = await fetchUpcomingEvents();

	// Populate the gallery with events
	populateEventGallery(events, locale, strings);
})();
