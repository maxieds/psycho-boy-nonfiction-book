// Check if data mode is enabled based on hostname
function useLoremData() {
	const hostname = window.location.hostname;

	return !hostname.includes("developer");
}

// Detect locale from HTML page and convert to API localization key
function getPageLocale() {
	const htmlLang = document.documentElement.lang || "en";

	// Map HTML lang codes to API localization keys
	const localeMap = {
		en: "en",
		"ja-JP": "ja",
		"zh-CN": "zh_Hans",
		"ko-KR": "ko",
	};

	return localeMap[htmlLang] || "en";
}

