        <line choice='manual_Gestetner_Drivers'/>
    </choices-outline>
    <!-- end manual outline -->
    <!-- SU outline -->
    <choices-outline ui='SoftwareUpdate'>
        <line choice='auto'/>
    </choices-outline>
    <!-- end SU outline -->
