<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<installer-gui-script minSpecVersion="1">
    <options visibleOnlyForPredicate="true" hostArchitectures="i386,x86_64" customize="never" rootVolumeOnly="true"/>
    <title>SU_TITLE</title>
    <script/>
    <!-- include package check here -->
    <script>
	var updateName = "PhotoContent_PackageData";
	function debuglog(message)
	{
		// yes, this is secure
		if (system.files.fileExistsAtPath("/tmp/com.apple.pkg.testing")) { 
			system.log("********** " + updateName + ": " + message);
		}
	}
	
	function arrayToObj(array)
	{
		var object = {};
		for (var i = 0; i &lt; array.length; i++)
		{
			object[array[i]]='';
		}
		return object;
	}
	
	function isEmpty(obj) 
	{
    		return Object.keys(obj).length === 0;
	}
	
	var tagObj = {};
	
	function getTagObj()
	{
		// Sanity check on input from my.evaluator
		if ((my.evaluator === undefined) || (my.evaluator.metainfo === undefined))
		{
			debuglog("my.evaulator or my.evaulator.metainfo is undefined, returning undefined.");
			return undefined;
		}
		// Making sure NSDictionary isn't null 
		if (my.evaluator.metainfo === null)
		{
			debuglog("my.evaulator.metainfo is null, returning undefined.");
			return undefined;
		}
		debuglog("Evaluator Metainfo NSDictionary is: " + my.evaluator.metainfo);
		debuglog("Evaluator Metainfo keys are: " + Object.keys(my.evaluator.metainfo));
		debuglog("Evaluator Metainfo PhotoPrintProductPackages value is: " + my.evaluator.metainfo["PhotoPrintProductPackages"]);
		// Check to only fill the tagObj once
		if ((tagObj === undefined) || (isEmpty(tagObj)))
		{
			debuglog("filling tagObj");
		
			// Real Dictionary	
			//rdar:16415395 Enhance: Distribution JavaScript should be able to "see" which SU tags were called
			//rdar:16425507 Enhance: Distribution JavaScript should be able to "see" which SU tags were called 
 			tagObj = arrayToObj(my.evaluator.metainfo["PhotoPrintProductPackages"]);
		}
		return tagObj;
	}

	debuglog("Update Name is: " + updateName);
	function checkNSDictionary(tag)
	{
		result = false;
		debuglog("Result before getTagObj for " + tag + " is: " + result);
		if (getTagObj() === undefined)
		{
			return false;
		}
		result = (tag in getTagObj());
		debuglog("Result after getTagObj for " + tag + " is: " + result);
		debuglog("Checking for tag " + tag + " gives result " + result );
		return result;
	}
	</script>
