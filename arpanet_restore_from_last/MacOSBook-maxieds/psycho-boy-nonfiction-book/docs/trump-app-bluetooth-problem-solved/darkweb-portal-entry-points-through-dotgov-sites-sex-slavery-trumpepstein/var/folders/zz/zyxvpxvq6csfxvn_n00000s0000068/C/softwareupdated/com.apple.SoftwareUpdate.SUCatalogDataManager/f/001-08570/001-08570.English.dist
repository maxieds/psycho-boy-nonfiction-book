<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<installer-gui-script minSpecVersion="1">
    <options affects-system-files="true" should-authenticate-reboot="true" allow-install-later="true" post-logout="true"/>
    <title>SU_TITLE</title>
