    <choice id="SecUpd2020-004HighSierra" description-mime-type="text/html" secondaryDescription="SU_SERVERCOMMENT" suDisabledGroupID="Security Update 2020-004" start_selected="true" versStr="SU_VERS" description="SU_DESCRIPTION" title="SU_TITLE" visible="Plist9(my.target.mountpoint)" start_enabled="true">
        <pkg-ref id="com.apple.pkg.update.os.SecUpd2020-004HighSierra.17G14019" auth="Root" packageIdentifier="com.apple.pkg.update.os.SecUpd2020-004HighSierra.17G14019" onConclusion="RequireRestart">SecUpd2020-004HighSierra.pkg</pkg-ref>
        <pkg-ref id="com.apple.pkg.SecUpd2020-004HighSierra.RecoveryHDUpdate.17G14019" auth="Root" packageIdentifier="com.apple.pkg.SecUpd2020-004HighSierra.RecoveryHDUpdate.17G14019" active="RecoveryHD10(my.target.mountpoint)" installEnvironment="ClientOS">SecUpd2020-004HighSierra.RecoveryHDUpdate.pkg</pkg-ref>
