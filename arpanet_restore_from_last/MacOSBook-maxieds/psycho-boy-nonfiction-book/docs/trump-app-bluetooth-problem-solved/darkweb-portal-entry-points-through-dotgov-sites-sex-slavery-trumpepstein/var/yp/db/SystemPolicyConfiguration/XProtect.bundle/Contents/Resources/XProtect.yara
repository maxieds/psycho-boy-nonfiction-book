import "hash"

private rule Macho
{
    meta:
        description = "private rule to match Mach-O binaries"
    condition:
        uint32(0) == 0xfeedface or uint32(0) == 0xcefaedfe or uint32(0) == 0xfeedfacf or uint32(0) == 0xcffaedfe or uint32(0) == 0xcafebabe or uint32(0) == 0xbebafeca

}

private rule PE
{
    meta:
        description = "private rule to match PE binaries"

    condition:
        uint16(0) == 0x5a4d and uint32(uint32(0x3C)) == 0x4550
}

private rule Dylib
{
    meta:
        description = "private rule to match Dylibs"

    condition:
        ((uint32(0) == 0xfeedface or uint32(0) == 0xfeedfacf) and uint32be(0xc) == 0x06000000) or
        (uint32(0) == 0xbebafeca and (uint32(uint32be(0x10)) == 0xfeedface or uint32(uint32be(0x10)) == 0xfeedfacf) and uint32be(uint32be(0x10) + 0xc) == 0x06000000)
}

private rule Shebang
{
    meta:
        description = "private rule to match shell scripts by shebang (!#)"

    condition:
        uint16(0) == 0x2123
}


private rule _golang_macho
{
    meta:
        description = "private rule to match machos compiled by Golang"
    strings:
        $gopclntab = "__gopclntab" ascii fullword
        $gosymtab = "__gosymtab" ascii fullword
        $build_magic_info = "\xff Go buildinf:" ascii
        $build_magic_id =  "\xff Go build ID: " ascii
        $symbol_name0 = "__cgo_init" ascii fullword
        $symbol_name1 = "__cgo_thread_start" ascii fullword
    condition:
        Macho and
        (
            ($gopclntab in (0..4096) and $gosymtab in (0..4096) ) or
            any of ($build_magic*) or
            all of ($symbol_name*)
        )
}rule XProtect_MACOS_644e18d
{
    meta:
        description = "MACOS.644e18d"
        uuid = "1ED79000-6E8D-4D08-BE52-646441233660"
