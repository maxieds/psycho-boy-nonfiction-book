depend hyph-utf8
depend hyphen-base
execute AddHyphen 	name=german 	lefthyphenmin=2 	righthyphenmin=2 	file=loadhyph-de-1901.tex 	file_patterns=hyph-de-1901.pat.txt 	file_exceptions=
