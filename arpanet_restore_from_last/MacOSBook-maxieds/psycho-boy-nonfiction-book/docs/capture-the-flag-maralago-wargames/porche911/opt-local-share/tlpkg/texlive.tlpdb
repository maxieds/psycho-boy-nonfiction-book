catalogue-license ofl lppl
catalogue-topics font font-serif font-t1enc font-proportional font-otf font-type1

name crimsonpro
category Package
revision 64565
shortdesc CrimsonPro fonts with LaTeX support
longdesc The CrimsonPro fonts are designed by Jacques Le Bailly and
longdesc derived from the Crimson Text fonts designed by Sebastian
longdesc Kosch. The family includes eight weights and italics for each
longdesc weight.
execute addMap CrimsonPro.map
docfiles size=24
 texmf-dist/doc/fonts/crimsonpro/OFL.txt
 texmf-dist/doc/fonts/crimsonpro/README details="Readme"
 texmf-dist/doc/fonts/crimsonpro/crimsonpro-samples.pdf details="Font samples"
 texmf-dist/doc/fonts/crimsonpro/crimsonpro-samples.tex
