 texmf-dist/source/latex/marginfix/marginfix.ins
runfiles size=4
 texmf-dist/tex/latex/marginfix/marginfix.sty
catalogue-ctan /macros/latex/contrib/marginfix
catalogue-license lppl
catalogue-topics marginal
catalogue-version 1.2

name marginnote
category Package
revision 68204
shortdesc Notes in the margin, even where \marginpar fails
longdesc This package provides the command \marginnote that may be used
longdesc instead of \marginpar at almost every place where \marginpar
