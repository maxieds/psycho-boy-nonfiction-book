 texmf-dist/source/latex/issuulinks/issuulinks.ins
runfiles size=1
 texmf-dist/tex/latex/issuulinks/issuulinks.sty
catalogue-ctan /macros/latex/contrib/issuulinks
catalogue-license lppl1.3
catalogue-topics label-ref hyper
catalogue-version 1.1

name istgame
category Package
revision 62946
shortdesc Draw Game Trees with TikZ
longdesc This LaTeX package provides macros based on TikZ to draw a game
longdesc tree. The main idea underlying its core macros is the
longdesc completion of a whole tree by using a sequence of simple
longdesc 'parent-child' tree structures, with no longer nested relations
longdesc involved (like the use of 'grandchildren' or
longdesc 'great-grandchildren'). Using this package you can draw a game
longdesc tree as easily as drawing a game tree with pen and paper. This
longdesc package depends on expl3, TikZ, and xparse. The 'ist' prefix
longdesc stands for "it's a simple tree" or "In-Sung's simple tree."
docfiles size=280
 texmf-dist/doc/latex/istgame/README.txt details="Readme"
 texmf-dist/doc/latex/istgame/istgame-doc-v2.1.tex
 texmf-dist/doc/latex/istgame/istgame-doc.pdf details="Package documentation"
 texmf-dist/doc/latex/istgame/istgame-doc.tex
 texmf-dist/doc/latex/istgame/istgame.ist
runfiles size=30
 texmf-dist/tex/latex/istgame/istgame.sty
catalogue-ctan /graphics/pgf/contrib/istgame
catalogue-license lppl1.3c
catalogue-topics pgf-tikz games tree expl3
catalogue-version 2.1

name itnumpar
category Package
revision 15878
shortdesc Spell numbers in words (Italian)
longdesc Sometimes we need to say "Capitolo primo" or "Capitolo uno"
longdesc instead of "Capitolo 1", that is, spelling the number in words
longdesc instead of the usual digit form. This package provides support
longdesc for spelling out numbers in Italian words, both in cardinal and
longdesc in ordinal form.
