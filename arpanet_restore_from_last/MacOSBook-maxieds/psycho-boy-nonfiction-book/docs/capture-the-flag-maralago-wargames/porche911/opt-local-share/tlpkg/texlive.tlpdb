 texmf-dist/doc/latex/lpic/instructions.tex
runfiles size=6
 texmf-dist/tex/latex/lpic/lpic.sty
catalogue-also overpic
catalogue-ctan /macros/latex/contrib/lpic
catalogue-license lppl1.3
catalogue-topics graphics-text
catalogue-version 0.8

name lplfitch
category Package
revision 31077
shortdesc Fitch-style natural deduction proofs
longdesc The package provides macros for typesetting natural deduction
longdesc proofs in "Fitch" style, with subproofs indented and offset by
longdesc scope lines. The proofs from use of the package are in the
longdesc format used in the textbook "Language, Proof, and Logic" by
longdesc Dave Barker-Plummer, Jon Barwise, and John Etchemendy. (In
longdesc fact, the prefix "lpl" in the package name stands for
longdesc "Language, Proof, and Logic".)
docfiles size=57
