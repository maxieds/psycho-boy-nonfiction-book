 texmf-dist/doc/bibtex/bestpapers/tex.bib
 texmf-dist/doc/bibtex/bestpapers/typography.bib
runfiles size=9
 texmf-dist/bibtex/bst/bestpapers/bestpapers-export.bst
 texmf-dist/bibtex/bst/bestpapers/bestpapers.bst
