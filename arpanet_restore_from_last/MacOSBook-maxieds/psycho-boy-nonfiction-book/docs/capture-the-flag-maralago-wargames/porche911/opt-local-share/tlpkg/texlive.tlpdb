 texmf-dist/doc/latex/ctanify/README details="Readme"
 texmf-dist/doc/latex/ctanify/ctanify.pdf details="Package documentation"
 texmf-dist/doc/man/man1/ctanify.1
 texmf-dist/doc/man/man1/ctanify.man1.pdf
runfiles size=6
 texmf-dist/scripts/ctanify/ctanify
