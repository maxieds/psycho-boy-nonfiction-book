 texmf-dist/tex/latex/cjk-ko/kolabels-utf.sty
 texmf-dist/tex/latex/cjk-ko/konames-utf.sty
 texmf-dist/tex/latex/cjk-ko/kotex.sty
catalogue-contact-repository https://github.com/dohyunkim/cjk-ko
catalogue-ctan /language/korean/cjk-ko
catalogue-license gpl lppl pd
catalogue-topics korean
