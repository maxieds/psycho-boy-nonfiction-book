\ProvidesFile{unmss.fd}
        [2014/12/04 Cyrillic Modern font definitions]
\DeclareUnicodeCharacter{20BD}{\ruble}
\DeclareFontFamily{U}{nmss}{\hyphenchar\font45 }
\DeclareFontShape{U}{nmss}{m}{n}
      {%
       <5><6><7><8>nmss8%
       <9>nmss9%
       <10><10.95>nmss10%
       <12><14.4>nmss12%
       <17.28><20.74><24.88>nmss17%
       }{}
% Font undefined, therefore substituted
\DeclareFontShape{U}{nmss}{m}{it}
       {<->sub*nmss/m/sl}{}
\DeclareFontShape{U}{nmss}{m}{sl}
     {%
       <5><6><7><8>nmssi8<9>nmssi9%
       <10><10.95>nmssi10%
       <12><14.4>nmssi12%
       <17.28><20.74><24.88>nmssi17%
       }{}
%%%%%%% Font/shape undefined, therefore substituted
\DeclareFontShape{U}{nmss}{m}{sc}
        {<->sub*nmr/m/sc}{}
%%%%%%% Font/shape undefined, therefore substituted
\DeclareFontShape{U}{nmss}{m}{ui}
        {<->sub*nmss/m/n}{}
%%%%%%%% semibold condensed series
\DeclareFontShape{U}{nmss}{sbc}{n}
      {%
       <5><6><7><8><9>nmssdc10%
        <10><10.95><12><14.4><17.28><20.74><24.88>nmssdc10%
        }{}
 
%%%%%%%%% bold extended series
\DeclareFontShape{U}{nmss}{bx}{n}
      {%
       <5><6><7><8><9>nmssbx10%
       <10><10.95><12><14.4><17.28><20.74><24.88>nmssbx10%
       }{}
%%%%%%% Font/shape undefined, therefore substituted
\DeclareFontShape{U}{nmss}{bx}{ui}
        {<->sub*nmss/bx/n}{}
\endinput
