      BoldFont          = {NewCM10-Bold},%
      BoldItalicFont    = {NewCM10-BoldItalic},%
      SlantedFont       = {NewCM08-Regular},%
      BoldSlantedFont   = {NewCM10-Bold}%
   },%
    {%
      Size              = {9-},%
      Font              = {NewCM10-Regular},%
