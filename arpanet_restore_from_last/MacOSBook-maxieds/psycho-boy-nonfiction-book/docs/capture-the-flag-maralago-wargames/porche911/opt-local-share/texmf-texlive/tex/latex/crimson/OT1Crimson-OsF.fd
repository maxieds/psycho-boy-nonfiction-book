      <-> \Crimson@@scale Crimson-Roman-osf-ot1
}{}

\DeclareFontShape{OT1}{Crimson-OsF}{regular}{n}{
      <-> alias * Crimson-OsF/m/n
}{}

\DeclareFontShape{OT1}{Crimson-OsF}{m}{scsl}{
    <-> ssub * Crimson-OsF/m/scit
}{}

\DeclareFontShape{OT1}{Crimson-OsF}{regular}{scsl}{
