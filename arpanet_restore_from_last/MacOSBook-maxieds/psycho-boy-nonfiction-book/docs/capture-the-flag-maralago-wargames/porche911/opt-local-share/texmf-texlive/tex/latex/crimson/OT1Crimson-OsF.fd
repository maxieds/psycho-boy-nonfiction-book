\expandafter\ifx\csname Crimson@scale\endcsname\relax
    \let\Crimson@@scale\@empty
\else
    \edef\Crimson@@scale{s*[\csname Crimson@scale\endcsname]}%
\fi

\DeclareFontFamily{OT1}{Crimson-OsF}{}


%   ----  b = bold  ----

\DeclareFontShape{OT1}{Crimson-OsF}{b}{it}{
      <-> \Crimson@@scale Crimson-BoldItalic-osf-ot1
}{}

