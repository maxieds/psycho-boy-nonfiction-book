}{}


%   ----  m = regular  ----

\DeclareFontShape{OT1}{Crimson-OsF}{m}{sc}{
      <-> \Crimson@@scale Crimson-Roman-osf-sc-ot1
}{}

\DeclareFontShape{OT1}{Crimson-OsF}{regular}{sc}{
      <-> alias * Crimson-OsF/m/sc
}{}

\DeclareFontShape{OT1}{Crimson-OsF}{m}{it}{
      <-> \Crimson@@scale Crimson-Italic-osf-ot1
}{}

\DeclareFontShape{OT1}{Crimson-OsF}{regular}{it}{
      <-> alias * Crimson-OsF/m/it
