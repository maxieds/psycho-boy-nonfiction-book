\ProvidesFile{ls2nmss.fd}
        [2014/12/22 Cyrillic Modern font definitions]
\DeclareFontFamily{LS2}{nmss}{}
\DeclareFontShape{LS2}{nmss}{m}{n}
     {%
      <5><6><7><8>ls2-nmss8%
      <9>ls2-nmss9%
      <10><10.95>ls2-nmss10%
      <12><14.4>ls2-nmss12%
      <17.28><20.74><24.88>ls2-nmss17%
      }{}
% Font undefined, therefore substituted
\DeclareFontShape{LS2}{nmss}{m}{it}
      {<->sub*nmss/m/sl}{}
\DeclareFontShape{LS2}{nmss}{m}{sl}
    {%
      <5><6><7><8ls2->nmssi8<9>ls2-nmssi9%
      <10><10.95>ls2-nmssi10%
      <12><14.4>ls2-nmssi12%
      <17.28><20.74><24.88>ls2-nmssi17%
      }{}
%%%%%%% Font/shape undefined, therefore substituted
\DeclareFontShape{LS2}{nmss}{m}{sc}
       {<->sub*nmr/m/sc}{}
%%%%%%% Font/shape undefined, therefore substituted
\DeclareFontShape{LS2}{nmss}{m}{ui}
       {<->sub*nmss/m/n}{}
%%%%%%%% semibold condensed series
\DeclareFontShape{LS2}{nmss}{sbc}{n}
     {%
      <5><6><7><8><9>ls2-nmssdc10%
       <10><10.95><12><14.4><17.28><20.74><24.88>ls2-nmssdc10%
       }{}

%%%%%%%%% bold extended series
\DeclareFontShape{LS2}{nmss}{bx}{n}
     {%
      <5><6><7><8><9>ls2-nmssbx10%
      <10><10.95><12><14.4><17.28><20.74><24.88>ls2-nmssbx10%
      }{}
%%%%%%% Font/shape undefined, therefore substituted
\DeclareFontShape{LS2}{nmss}{bx}{ui}
       {<->sub*nmss/bx/n}{}
\endinput
