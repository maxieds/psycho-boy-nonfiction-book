%------------------------   filenames stop -------------------------
\else
%------------------------   symbolic names start -------------------------
\setmainfont{TeX Gyre bonum}[ 
  RawFeature        = {\bonum@figurealign,\bonum@figurestyle},
  Scale             = \bonumRM@scale ,
  UprightFont       = * Regular,
  SlantedFont       = * Regular,
