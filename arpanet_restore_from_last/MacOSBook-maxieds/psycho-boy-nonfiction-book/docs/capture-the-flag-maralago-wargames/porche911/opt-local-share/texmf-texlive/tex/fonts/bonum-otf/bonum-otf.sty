\ProvidesPackage{bonum-otf}[%
  2024/07/23 v. 0.01 (Herbert Voss) Supports TeX Gyre bonum fonts for lualatex and xelatex.] 

\RequirePackage{iftex,xkeyval,textcomp}

\newif\ifbonum@lining \bonum@liningtrue
\newif\ifbonum@tabular \bonum@tabulartrue
\newif\ifbonum@usefilenames \bonum@usefilenamestrue
\newif\ifbonum@nomath \bonum@nomathfalse
\newif\ifbonum@libertinus \bonum@libertinusfalse

\DeclareOptionX{lining}[true]{\@nameuse{bonum@lining#1}}
\DeclareOptionX{nf}[true]{\@nameuse{bonum@lining#1}}
\DeclareOptionX{lf}[true]{\@nameuse{bonum@lining#1}}
\DeclareOptionX{oldstyle}[true]{\@nameuse{if#1}\bonum@liningfalse\else\bonum@liningtrue\fi}
\DeclareOptionX{osf}[true]{\@nameuse{if#1}\bonum@liningfalse\else\bonum@liningtrue\fi}
\DeclareOptionX{libertinus}[true]{\@nameuse{bonum@libertinus#1}}

\newcommand*\bonumMM@feature{}
\DeclareOptionX{math}[]{\renewcommand*\bonumMM@feature{#1}}
\DeclareOptionX{nomath}[true]{\@nameuse{bonum@nomath#1}}

\DeclareOptionX{usefilenames}[true]{\@nameuse{bonum@usefilenames#1}}

\DeclareOptionX{tabular}[true]{\@nameuse{bonum@tabular#1}}
\DeclareOptionX{t}[true]{\@nameuse{bonum@tabular#1}}
\DeclareOptionX{proportional}[true]{\@nameuse{if#1}\bonum@tabularfalse\else\bonum@tabulartrue\fi}
\DeclareOptionX{p}[true]{\@nameuse{if#1}\bonum@tabularfalse\else\bonum@tabulartrue\fi}

\newcommand*\bonumRM@scale{1}  
\DeclareOptionX{ScaleRM}{\renewcommand*{\bonumRM@scale}{#1}}

\def\bonum@defaultfeatures{}
\DeclareOptionX{defaultfeatures}{\def\bonum@defaultfeatures{#1}}

\ProcessOptionsX\relax

\RequirePackage{unicode-math}

\ifbonum@lining
    \def\bonum@figurestyle{+lnum}
\else
    \def\bonum@figurestyle{+onum}
\fi

\ifbonum@tabular
    \def\bonum@figurealign{+tnum} 
\else
    \def\bonum@figurealign{+pnum} 
\fi

\ifxetex\XeTeXtracingfonts=1\fi
\defaultfontfeatures[\rmfamily,\sffamily]{
     Ligatures = TeX ,
     SmallCapsFeatures={Letters=SmallCaps},%       \ifluatex,Renderer=Basic\fi}, 
     \bonum@defaultfeatures
}

\ifbonum@usefilenames
%------------------------   filenames start -------------------------

%texgyrebonum-bold.otf		texgyrebonum-italic.otf
%texgyrebonum-bolditalic.otf	texgyrebonum-regular.otf


\setmainfont{texgyrebonum}[ 
  RawFeature     = {\bonum@figurealign;\bonum@figurestyle},
  Scale          = \bonumRM@scale ,
  UprightFont    = *-regular,
  ItalicFont     = *-italic,
  ItalicFeatures = { SmallCapsFont = *-italic },
  SlantedFont    = *-regular,
  SlantedFeatures= {FakeSlant=0.2},
  BoldFont       = *-bold,
  BoldFeatures   = { SmallCapsFont = *-bold },
  BoldItalicFont = *-bolditalic,
  BoldItalicFeatures = { SmallCapsFont = *-bolditalic },
  BoldSlantedFont= *-bold,
  BoldSlantedFeatures= {FakeSlant=0.2, SmallCapsFont = *-bold },
  SmallCapsFont  = *-regular,
%  SmallCapsFeatures={RawFeature=+smcp},
  SmallCapsFeatures={Letters=SmallCaps}, 
  Extension      = .otf  
]

