\DeclareFontShape{TS1}{yrd}{bx}{si}{<->ssub * yrd/b/si}{}
\DeclareFontShape{TS1}{yrd}{m}{sl}{<->ssub * yrd/m/it}{}
\DeclareFontShape{TS1}{yrd}{db}{sl}{<->ssub * yrd/m/sl}{}
