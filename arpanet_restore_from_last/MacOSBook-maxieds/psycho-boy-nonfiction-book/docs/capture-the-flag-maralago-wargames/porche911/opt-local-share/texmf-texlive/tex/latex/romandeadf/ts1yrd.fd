\ProvidesFile{ts1yrd.fd}
   [2024/08/12 Fontinst v1.933 font definitions for TS1/yrd.]

% addaswyd o t1phv.fd (dyddiad y ffeil fd: 2020-03-25)
\expandafter\ifx\csname yrd@scale\endcsname\relax
  \let\yrd@@scale\@empty
\else
  \edef\yrd@@scale{s*[\csname yrd@scale\endcsname]}%
\fi

\DeclareFontFamily{TS1}{yrd}{}

\DeclareFontShape{TS1}{yrd}{m}{n}{
   <-> \yrd@@scale yrdr8c
}{}

\DeclareFontShape{TS1}{yrd}{m}{sc}{
   <-> \yrd@@scale yrdr8c
}{}

\DeclareFontShape{TS1}{yrd}{m}{it}{
   <-> \yrd@@scale yrdri8c
}{}

\DeclareFontShape{TS1}{yrd}{db}{n}{
   <-> \yrd@@scale yrdd8c
}{}

\DeclareFontShape{TS1}{yrd}{db}{sc}{
   <-> \yrd@@scale yrdd8c
}{}

\DeclareFontShape{TS1}{yrd}{db}{it}{
   <-> \yrd@@scale yrddi8c
}{}

\DeclareFontShape{TS1}{yrd}{m}{scit}{<->ssub * yrd/m/sc}{}
\DeclareFontShape{TS1}{yrd}{db}{scit}{<->ssub * yrd/m/scit}{}
