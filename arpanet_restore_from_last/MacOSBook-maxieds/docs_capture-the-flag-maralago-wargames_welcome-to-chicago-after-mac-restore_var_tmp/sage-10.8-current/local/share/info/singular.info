     def B = appendWeight2Ord(w);  // for a non-commutative ring
     setring B; B;
     ==> // coefficients: QQ considered as a field
     ==> // number of vars : 4
     ==> //        block   1 : ordering a
     ==> //                  : names    a b x d
     ==> //                  : weights  2 1 1 1
     ==> //        block   2 : ordering Dp
     ==> //                  : names    a b x d
     ==> //        block   3 : ordering C
     ==> // noncommutative relations:
     ==> //    ba=ab+3a
     ==> //    da=ad+3x2
     ==> //    xb=bx-x
     ==> //    db=bd+d
     ==> //    dx=xd+1


