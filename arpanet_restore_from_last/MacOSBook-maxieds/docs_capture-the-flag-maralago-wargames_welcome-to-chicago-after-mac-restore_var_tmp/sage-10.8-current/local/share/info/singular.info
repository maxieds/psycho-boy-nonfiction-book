     list T=purityFiltration(transpose(R));
     // all Elements of T[2] are either zero or pure
     purelist(T[2]);
     ==> [1]:
     ==>    1
     ==> [2]:
     ==>    1
     ==> [3]:
     ==>    1
     ==> [4]:
     ==>    1


