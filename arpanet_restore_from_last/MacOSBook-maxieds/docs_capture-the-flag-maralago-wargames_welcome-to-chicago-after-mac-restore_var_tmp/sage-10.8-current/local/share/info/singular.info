     ==> 0, 0,0,0, 0, 0, 0,
     ==> h2,0,h,2h,3h,4h,5h
     setring(E);
     intvec  c= 0,-3;
     intvec I = 0;
     intvec J = 0,1;
     intvec K = 0,2;
     multigradedcomplex U = regionComplex(tate,c,I,J,K);
     U;
     ==> 0  <--  E^10  <--  E^8  <--  E^6  <--  E^4  <--  E^2  <--  E^2  <--  0
