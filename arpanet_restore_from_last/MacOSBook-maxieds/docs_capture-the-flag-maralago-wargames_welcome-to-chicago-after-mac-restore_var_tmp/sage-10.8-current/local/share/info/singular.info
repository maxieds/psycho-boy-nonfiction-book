     ==>   0 :  1   1   -   -   -   - |..2
     ==>   0 :  -   1   -   -   -   - |..3
     ==>   1 :  -   -   -   -   -   - |..4
     ==>   0 :  -   -   1   -   -   - |..5
     ==>   0 :  -   -   1   1   -   - |..6
