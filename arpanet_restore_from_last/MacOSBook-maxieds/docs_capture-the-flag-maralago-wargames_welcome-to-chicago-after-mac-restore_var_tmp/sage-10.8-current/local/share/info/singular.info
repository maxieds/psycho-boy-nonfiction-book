     2, 0,
     0, 3;
     intmat A[3][4] =
     1, 2, 3, 0,
     7, 0, 0, 0,
     1, 2, 0, 3;
     print( A );
     ==>      1     2     3     0
     ==>      7     0     0     0
     ==>      1     2     0     3
     isGroupHomomorphism(L1, L2, A);
     ==> 1
     intmat B[3][4] =
     1, 2, 3, 0,
     7, 0, 0, 0,
     1, 2, 0, 2;
     print( B );
     ==>      1     2     3     0
     ==>      7     0     0     0
     ==>      1     2     0     2
     isGroupHomomorphism(L1, L2, B); // Not a homomorphism!
     ==> 0


