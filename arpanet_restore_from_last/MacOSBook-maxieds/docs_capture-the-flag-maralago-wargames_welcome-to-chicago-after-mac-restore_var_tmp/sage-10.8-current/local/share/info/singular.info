     def r = nc_algebra(1,D); setring r; // this is U(sl_2)
     poly p=4*x*y+z^2-2*z;
     inCenter(p);
     ==> 1
     poly f=4*x*y;
     inCenter(f);
     ==> 0
     list l= list( 1, p, p^2, p^3);
     inCenter(l);
     ==> 1
     ideal I= p, f;
     inCenter(I);
     ==> 0


