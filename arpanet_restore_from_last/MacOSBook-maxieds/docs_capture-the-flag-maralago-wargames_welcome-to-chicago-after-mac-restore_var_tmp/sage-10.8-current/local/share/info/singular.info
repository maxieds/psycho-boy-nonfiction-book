     ncrep q = ncrepGet(f);
     ncrepDim(q);
     ==> 11
     ncrep s = ncrepRegularZeroMinimize(q, list(x, y));
     ncrepDim(s);
     ==> 3
     s;
     ==> lvec=
     ==> 0,1,0
     ==>
     ==> mat=
     ==> 1, y, 0,
     ==> -x,1, -y,
     ==> 0, -x,1
     ==>
     ==> rvec=
     ==> 0,
     ==> -1,
     ==> 0
     ==>


