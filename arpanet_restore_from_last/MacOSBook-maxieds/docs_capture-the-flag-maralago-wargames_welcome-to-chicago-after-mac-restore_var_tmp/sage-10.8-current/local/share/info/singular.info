     ==>       _[1]=x
     ==> [2]:
     ==>    [1]:
     ==>       _[1]=x*gen(1)+y*gen(2)
     ==>       _[2]=x*gen(2)-gen(1)
     ==>    [2]:
     ==>       _[1]=x2+y


