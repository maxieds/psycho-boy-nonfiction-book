     ==> //    e(1)(1)e(0)(1)=-e(0)(1)*e(1)(1)
     ==> //    e(1)(2)e(0)(1)=-e(0)(1)*e(1)(2)
     ==> //    e(1)(1)e(1)(0)=-e(1)(0)*e(1)(1)
     ==> //    e(1)(2)e(1)(0)=-e(1)(0)*e(1)(2)
