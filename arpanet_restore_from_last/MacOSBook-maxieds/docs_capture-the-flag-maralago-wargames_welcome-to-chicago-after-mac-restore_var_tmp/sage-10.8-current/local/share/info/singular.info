     ==>       1
     ==>    [2]:
     ==>       [1]:
     ==>          _[1]=(x)
     ==>       [2]:
     ==>          _[1]=(y)
     ==>          _[2]=(x)
     ==> [2]:
     ==>    [1]:
     ==>       3
     ==>    [2]:
     ==>       [1]:
     ==>          _[1]=(z)
     ==>          _[2]=(y)
