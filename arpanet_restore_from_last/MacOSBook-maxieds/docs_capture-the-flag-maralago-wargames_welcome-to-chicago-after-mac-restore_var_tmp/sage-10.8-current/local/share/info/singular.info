     ==> 9
     maxdeg1(f);
     ==> 3
     intvec v = ringweights(r);
     maxdeg1(f,v);                        //weighted maximal degree
     ==> 9
     matrix m[2][2]=f+x10,1,0,f^2;
     maxdeg1(m,v);                        //absolute weighted maximal degree
     ==> 18


