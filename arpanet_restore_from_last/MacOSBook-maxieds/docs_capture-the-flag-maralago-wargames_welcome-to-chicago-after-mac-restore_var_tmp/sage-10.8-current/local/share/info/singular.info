     ==> [-18293234/799051, 73172936/2397153],[-7807572/799051, 15513600/799051]
     ==>
     ivmat Jadj = diagMatrix(2, 1/det(J)) * adjunct(J);
     Jadj;
     ==> [620/4273, 1060/187],[-1220/561, -180/4273]
     ==> [2680/12819, 1280/187],[-3680/561, -920/4273]
     ==>
