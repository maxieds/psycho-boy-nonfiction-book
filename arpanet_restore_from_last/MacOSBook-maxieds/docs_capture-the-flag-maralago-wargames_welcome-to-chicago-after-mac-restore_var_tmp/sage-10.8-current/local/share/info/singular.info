     ==>   1 :  -   -   -   -   -   - |..4
     ==>   0 :  -   -   1   -   -   - |..5
     ==>   0 :  -   -   1   1   -   - |..6
     ==>   0 :  -   -   -   1   -   - |..7
     ==>   1 :  -   -   -   -   -   - |..8
     ==>  -1 :  -   -   -   -   -   - |..9
     ==>  -2 :  -   -   -   -   -   - |.10
