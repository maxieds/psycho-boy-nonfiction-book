     Matrix M=m;
     Module N=coker(M);
     N;
     ==> cokernel | x y z |
     ==>
     ==>
     Resolution R = mRes(N);
     R;
     ==>  1      3      3      1
     ==> r <--  r <--  r <--  r
     ==>
     ==> 0      1      2      3
     ==>
     ==>
     R.dd[2];
     ==>      {2}  {2}  {2}
     ==> {1}    y    x    0
     ==> {1}   -z    0    x
     ==> {1}    0   -z   -y
     ==>


