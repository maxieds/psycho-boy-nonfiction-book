     +24x9y3+4x9y2-16x8y3+26x7y4-6x6y4+8x5y5+4x3y6-y8;
     signatureNemethi(N,f,1);
     ==> -92
     printlevel = 1;
     signatureNemethi(N,f);
     ==> Resolution of singularity has been used.
     ==> -92


