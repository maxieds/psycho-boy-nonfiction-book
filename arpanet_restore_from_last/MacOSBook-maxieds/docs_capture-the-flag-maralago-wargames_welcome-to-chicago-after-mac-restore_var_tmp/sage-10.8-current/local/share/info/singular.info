     index (indices) l.

*Example:*
     LIB "classify.lib";
     ring r=0,(x,y,z),(c,ds);
     init_debug(0);
     singularity("E[6k]",6);
     ==> [1]:
     ==>    x3+xy13+y19
     ==> [2]:
     ==>    2
     singularity("T[k,r,s]", 3, 7, 5);
     ==> [1]:
     ==>    x3+xyz+z5+y7
     ==> [2]:
     ==>    3
     poly f=y;
     singularity("J[k,r]", 4, 0, 0, f);
     ==> [1]:
     ==>    x3+x2y4+y13
     ==> [2]:
     ==>    2


