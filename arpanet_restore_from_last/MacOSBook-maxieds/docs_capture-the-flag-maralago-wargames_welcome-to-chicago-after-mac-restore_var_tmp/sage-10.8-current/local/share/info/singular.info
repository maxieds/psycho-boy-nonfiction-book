     ==> 1
     intmat V = multiDeg(I); print(V);
     ==>      1     1    10
     ==>      0     2    10
     module S = syz(I); print(S);
     ==> -y,x4y5,
     ==> x, 0,
     ==> 0, -1
     S = setModuleGrading(S, V);
     getModuleGrading(S) == V;
     ==> 1
     vector v = getGradedGenerator(S, 1);
     getModuleGrading(v) == V;
     ==> 1
     isHomogeneous(v);
     ==> 1
     print( multiDeg(v) );
     ==> 2,
     ==> 2
     isHomogeneous(S);
     ==> 1
     print( multiDeg(S) );
     ==>      2    10
     ==>      2    10


