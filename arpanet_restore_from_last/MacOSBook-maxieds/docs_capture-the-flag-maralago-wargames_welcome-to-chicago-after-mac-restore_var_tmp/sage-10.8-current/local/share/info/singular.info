     ==> Normal form equation = x2y-y3
     ==> Milnor number = 4
     ==> Modality = 0
     ==> Determinacy <= 3
     ==>
     addnondegeneratevariables(NFR[1]);
     ==> Corank = 2
     ==> Inertia index = 0
     ==> Normal form equation of type = D[4]-
     ==> Normal form equation = z2+x2y-y3
     ==> Milnor number = 4
     ==> Modality = 0
     ==> Determinacy <= 3
     ==>

