     ring r = 0, (x, y, z),ds;
     vector v = [-1,-1,-1];
     VecField V = v;
     V.precision = 4;
     map phi = r, x-2y2+z3,2y+y3+z,z;
     map phiinv = invertAlgebraMorphism(phi,4);


