     LIB "arcpoint.lib";
     ring r=0,(x,y,z),dp;
     ideal I = x3,y+z2-x2;
     I;
     ==> I[1]=x3
     ==> I[2]=-x2+z2+y
     removepower(I);
     ==> _[1]=x
     ==> _[2]=-x2+z2+y

