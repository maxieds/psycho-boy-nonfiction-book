     0, 1, 0,
     0, 0, 1;
     intmat L[3][2] =
     1, 1,
     1, 3,
     1, 5;
     // The group Z^3 / L can be constructed as follows:
     // shortcut:
     def G = createQuotientGroup(L);
     printGroup(G);
     ==> Generators:
     ==>      1     0     0
     ==>      0     1     0
     ==>      0     0     1
     ==> Relations:
     ==>      1     1
     ==>      1     3
     ==>      1     5
     // the general way:
     def GG = createGroup(I, L); // (I+L)/L
     printGroup(GG);
     ==> Generators:
     ==>      1     0     0
     ==>      0     1     0
     ==>      0     0     1
     ==> Relations:
     ==>      1     1
     ==>      1     3
     ==>      1     5


