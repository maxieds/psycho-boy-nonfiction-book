*Example:*
     LIB "reszeta.lib";
     ring r = 0,(x(1..3)),dp(3);
     ideal J=x(3)^5+x(2)^4+x(1)^3+x(1)*x(2)*x(3);
     list re=resolve(J);
     list di=intersectionDiv(re);
     di;
     ==> [1]:
     ==>    -3,1,1,
     ==>    1,-4,1,
     ==>    1,1,-2
     ==> [2]:
     ==>    0,0,0
     ==> [3]:
     ==>    [1]:
     ==>       [1]:
     ==>          3,1,1
     ==>       [2]:
     ==>          5,1,1
     ==>    [2]:
     ==>       [1]:
     ==>          3,1,2
     ==>       [2]:
     ==>          4,1,1
     ==>       [3]:
     ==>          5,1,2
     ==>    [3]:
     ==>       [1]:
     ==>          4,2,1
     ==>       [2]:
     ==>          5,2,1
     ==> [4]:
     ==>    1,1,1


