     intmat L[2][1] =
     0,
     2;
     def G = createGroup(S, L); // (S+L)/L
     printGroup(G);
     ==> Generators:
     ==>      1    -2     1
     ==>      1     1     0
     ==> Relations:
     ==>      0
     ==>      2
     kill S, L, G;
     // ----------- extreme case ------------ //
     intmat S[1][3] =
     1,  -1, 10;
     // Torsion:
     intmat L[1][1] =
     0;
     def G = createGroup(S, L); // (S+L)/L
     printGroup(G);
     ==> Generators:
     ==>      1    -1    10
     ==> Relations:
     ==>      0


