     ring r0 = 0,(x,y),ls;
     ideal I = -1x2y6-1x4y2, 7x6y5+1/2x7y4+6x4y6;
     staircase("",std(I));
     ==>
     ==> Show[Graphics[{
     ==> {GrayLevel[0.5],Map[Rectangle[#,{9,9}] &, {{2,6},{6,2}}]},
     ==> {PointSize[0.03], Map[Point,{{2,6},{6,2}}]},
