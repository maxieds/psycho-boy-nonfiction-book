     ring r = 0,(x,y),dp;
     ring R = freeAlgebra(r, 4);
     poly a = x*y; poly b = y;
     lieBracket(a,b);
     ==> -y*x*y+x*y*y
     lieBracket(x,y,2);
     ==> y*x*x-2*x*y*x+x*x*y


