          ==>    0,1,1,1,0
          ==> [3]:
          ==>    1,0,1,0,1
          ==> [4]:
          ==>    0,0,1,1,1
            indepSet(I,1);
          ==> [1]:
          ==>    1,1,1,0,0
          ==> [2]:
          ==>    0,1,1,1,0
          ==> [3]:
          ==>    1,0,1,0,1
          ==> [4]:
          ==>    0,0,1,1,1
          ==> [5]:
          ==>    0,1,0,0,1
            eliminate(I,xuv);
          ==> _[1]=0

