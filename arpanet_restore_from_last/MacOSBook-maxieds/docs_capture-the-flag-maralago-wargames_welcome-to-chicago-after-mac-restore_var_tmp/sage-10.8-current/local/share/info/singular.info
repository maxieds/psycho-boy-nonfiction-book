     ring r;
     module m = [x],[y],[1,z];
     is_zero(m,1);
     ==> [1]:
     ==>    0
     ==> [2]:
     ==>    2
     qring q = std(ideal(x2+y3+z2));
     ideal j = x2+y3+z2-37;
     is_zero(j);
     ==> 1


