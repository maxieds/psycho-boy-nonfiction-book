     def ER = superCommutative(2); // (b = 2, e = N)
     setring ER; ER;
     ==> // coefficients: ZZ/2 considered as a field
     ==> // number of vars : 4
     ==> //        block   1 : ordering dp
     ==> //                  : names    x(1) x(2) x(3) x(4)
     ==> //        block   2 : ordering C
     ==> // quotient ring from ideal
     ==> _[1]=x(4)^2
     ==> _[2]=x(3)^2
     ==> _[3]=x(2)^2
     "Alternating variables: [", AltVarStart(), ",", AltVarEnd(), "].";
     ==> Alternating variables: [ 4 , 4 ].
