     ring Z = cohomologyMatrixFromResolution(tate,low,high);
     setring(Z);
     print(cohomologymat);
     ==> 5h,0,5,10,15,20,25,
     ==> 4h,0,4,8, 12,16,20,
     ==> 3h,0,3,6, 9, 12,15,
