     ==> LD[3]=z^2*Dx-x^2*Dz
     ==> LD[4]=y^2*Dx-x^2*Dy
     ==> LD[5]=x^3*Dz+y^3*Dz+z^3*Dz+6*z^2
     ==> LD[6]=x^3*Dy+y^3*Dy+y^2*z*Dz+6*y^2
     BS;
     ==> [1]:
     ==>    _[1]=-2
     ==>    _[2]=-5/3
     ==>    _[3]=-4/3
     ==>    _[4]=-1
     ==> [2]:
     ==>    1,1,1,2


