     ==> $dt^{2}\cdot Tt^{2}+(2dtdh+2dt)\cdot Tt+(dh^{2}+2dh+2A+1)$
     string t = xchange(s,"dh","dt");
     t;
     ==> $dh^{2}\cdot Tt^{2}+(2dhdt+2dh)\cdot Tt+(dt^{2}+2dt+2A+1)$


