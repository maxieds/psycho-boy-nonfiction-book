     ==>  2 : 1 |.2
     ==>  2 : 1 |.3
     ==>  2 : 1 |.4
     ==>     ==
     ==>      3
     ==> d_3 :
     ==> Graded homomorphism: S(-3) <- 0, given by zero (1 x 0) matrix.
     grlifting(M, N); // grview(G);
     ==> t:  2
     ==> _[1]=26642*gen(4)+24263*gen(3)+5664*gen(2)+24170*gen(1)
