     ==> $-2\cdot (-x+y)\cdot (x+y+1)^{2}\cdot x^{3}\cdot y^{13}$
     ring R49 = (7,a),x,dp;
     minpoly = a2+a+3;
     poly f = (a24x5+x3)*a2x6*(x+1)^2;
     f;
     ==> (a+3)*x13+(2a-1)*x12+(-2a+1)*x10+(-a-3)*x9
     texfactorize("",f);
     ==> $(a+3)\cdot (x-1)\cdot (x+1)^{3}\cdot x^{9}$


