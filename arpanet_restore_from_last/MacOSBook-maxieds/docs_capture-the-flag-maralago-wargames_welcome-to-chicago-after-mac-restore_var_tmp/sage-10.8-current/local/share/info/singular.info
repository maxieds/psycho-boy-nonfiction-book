     qring Q = std(ideal( y^6+ x*y^3*z-x^2*z^2 ));
     intmat M[2][3] = 1, 1, 2,     2, 1, 1;
     //  intmat T[2][1] = 0, 2;
     setBaseMultigrading(M); // BUG????
