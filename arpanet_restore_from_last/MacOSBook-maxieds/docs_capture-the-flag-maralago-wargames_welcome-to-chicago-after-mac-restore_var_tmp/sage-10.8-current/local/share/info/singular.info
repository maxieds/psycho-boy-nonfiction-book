     ==> S(-2) <-- d_2 --
     ==> 0, given by maps:
     ==> d_1 :
     ==> Graded homomorphism: S(-1)^4 <- S(-2), given by a matrix, with degrees:
     ==>     .1 ...
     ==>     -- +..
     ==>  1 : 1 |.1
     ==>  1 : 1 |.2
     ==>  1 : 1 |.3
     ==>  1 : 1 |.4
     ==>     ==
     ==>      2
     ==> d_2 :
     ==> Graded homomorphism: S(-2) <- 0, given by zero (1 x 0) matrix.
     //   module N = grshift(kos[3], 1); // psi, Syz_2(K(1))
     def N = KeneshlouMatrixPresentation(intvec(0,1,0,0));
     grview( grres(N, 0) );
