     //   j; print(M);
     //   ring S=0,(a,b,c,x,z,y),ds;
     //   imapall(R);         //map from R to S: x->x, y->y, z->z, u->0
     //   names(S);
     //   j; print(M);
     //   imapall(S,"1");     //identity map of S: copy objects, change names
