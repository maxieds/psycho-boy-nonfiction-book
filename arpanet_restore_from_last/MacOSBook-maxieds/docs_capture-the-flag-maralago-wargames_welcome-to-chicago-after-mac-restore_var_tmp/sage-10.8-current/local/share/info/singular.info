     ==> I[6]=t*r*t*r*t*r+1
     ==> I[7]=r*r+t*t
     ==> I[8]=t*r*t*r*t*r+y*x+x*y
     ==> I[9]=t*r*t*r*t*r+r*r
     ==> I[10]=t*r*t*r*t*r+t*t
     ==> I[11]=r*x*r+x
     ==> I[12]=t*y*t+y
     ==> I[13]=t*x*t+X*y
     ==> I[14]=r*y*r+x*Y
     ==> I[15]=X*x+1
     ==> I[16]=x*X+1
     ==> I[17]=Y*y+1
     ==> I[18]=y*Y+1


