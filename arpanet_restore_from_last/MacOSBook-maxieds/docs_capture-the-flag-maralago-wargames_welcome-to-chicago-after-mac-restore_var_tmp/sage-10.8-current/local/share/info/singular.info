     ==>       _[3]=x(1)^2*x(2)^7*x(3)-x(1)^2*x(2)^7+2*x(1)*x(2)^6*x(3)-2*x(1)*x(2\
        )^6+x(2)^5*x(3)-x(2)^5
     ==>       _[4]=a
     ==>    [3]:
     ==>       a
     ==>    [4]:
     ==>       [1]:
     ==>          4
     ==>       [2]:
     ==>          2
     ==>       [3]:
     ==>          2
     ==>       [4]:
     ==>          2
     ==>    [5]:
     ==>       [1]:
     ==>          2
     ==>       [2]:
     ==>          1
     ==>       [3]:
     ==>          2
     ==>       [4]:
     ==>          2
     ==>    [6]:
     ==>       [1]:
     ==>          _[1]=0
     ==>          _[2]=1
     ==>          _[3]=0
     ==>       [2]:
     ==>          _[1]=1
     ==>          _[2]=0
     ==>          _[3]=0
     ==>       [3]:
