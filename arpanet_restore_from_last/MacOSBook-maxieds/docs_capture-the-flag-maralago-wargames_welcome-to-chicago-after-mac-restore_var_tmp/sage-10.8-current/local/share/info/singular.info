*Example:*
     LIB "ffsolve.lib";
     ring R = (2,a),x(1..3),lp;
     minpoly=a2+a+1;
     ideal I;
     I[1]=x(1)^2*x(2)+(a)*x(1)*x(2)^2+(a+1);
     I[2]=x(1)^2*x(2)*x(3)^2+(a)*x(1);
     I[3]=(a+1)*x(1)*x(3)+(a+1)*x(1);
     simplesolver(I);
     ==> [1]:
     ==>    _[1]=x(3)+1
     ==>    _[2]=x(2)+(a)
     ==>    _[3]=x(1)+1
     ==> [2]:
     ==>    _[1]=x(3)+1
     ==>    _[2]=x(2)+(a+1)
     ==>    _[3]=x(1)+(a+1)


