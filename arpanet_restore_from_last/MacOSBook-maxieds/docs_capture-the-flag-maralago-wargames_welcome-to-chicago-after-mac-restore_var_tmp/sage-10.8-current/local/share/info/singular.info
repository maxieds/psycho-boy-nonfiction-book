     basering;///does show the ring
     ==> // coefficients: QQ(I, T, Px, Py, Cx, Cy, Sx, Sy, a, b, dt, dx, dy) consi\
        dered as a field
     ==> // number of vars : 8
     ==> //        block   1 : ordering c
     ==> //        block   2 : ordering lp
     ==> //                  : names    i t x y cx cy sx sy
     ==> // quotient ring from ideal
     ==> _[1]=cy^2+sy^2-1
     ==> _[2]=cx^2+sx^2-1
     ==> _[3]=i^2+1
     poly f=t**3*cx**2-cy**2*dt+i**3*sx/dt*dx;
     f;
     ==> (dx)/(dt)*i^3*sx+t^3*cx^2+(-dt)*cy^2
     def g=VarToPar(f);
     g;
     ==> (I^3*Sx*dx+T^3*Cx^2*dt-Cy^2*dt^2)/(dt)
     def h=ParToVar(g);
     h==f;
     ==> 1


