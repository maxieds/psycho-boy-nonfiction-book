     list l=dec1var(N);
     l;
     ==> [1]:
     ==>    [1]:
     ==>       _[1]=gen(2)
     ==>       _[2]=gen(3)
     ==>       _[3]=z*gen(1)
     ==>    [2]:
     ==>       _[1]=z
     ==> [2]:
     ==>    [1]:
     ==>       _[1]=gen(1)
     ==>       _[2]=gen(3)
     ==>       _[3]=z*gen(2)-gen(2)
     ==>    [2]:
     ==>       _[1]=z-1
     ==> [3]:
     ==>    [1]:
     ==>       _[1]=gen(1)
     ==>       _[2]=gen(2)
     ==>       _[3]=z*gen(3)+gen(3)
     ==>    [2]:
     ==>       _[1]=z+1


