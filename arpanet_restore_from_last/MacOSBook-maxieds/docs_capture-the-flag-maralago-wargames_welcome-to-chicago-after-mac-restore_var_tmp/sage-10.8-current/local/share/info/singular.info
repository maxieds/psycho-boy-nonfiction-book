     intmat B[2][3]=1,-1,-2,0,0,1;
     v = setModuleGrading(v,B);
     getModuleGrading(v);
     ==> 1,-1,-2,
     ==> 0,0,1
     multiDegPartition(v, B);
     ==> _[1]=x4y*gen(3)-x3y2*gen(2)
     ==> _[2]=xy*gen(1)


