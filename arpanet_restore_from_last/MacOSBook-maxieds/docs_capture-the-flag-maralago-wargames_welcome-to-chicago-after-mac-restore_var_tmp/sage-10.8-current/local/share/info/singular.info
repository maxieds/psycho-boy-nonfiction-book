     ==> hilbert_series_denom : 1,1
     ==> class_group : 0
     //now the same example with another grading
     intvec grading = 2,3,1;
     intclToricRing(I,grading);
     ==> _[1]=x
     ==> _[2]=y
     showNuminvs();
     ==> hilbert_basis_elements : 2
