     ivmat J = evalJacobianAtBox (I, B); J;
     ==> [69/20, 23/5],[-61/40, -27/40]
     ==> [67/20, 24/5],[-159/40, -93/40]
     ==>
     list result = ivmatGaussian2(J);
     ivmat Jinv = result[2];
     Jinv;
