     ring r = 0,(x,y,z),(Dp(2),dp(1));
     list L = ringlist(r);
     list N = convloc(L);
     def rs = ring(N);
     setring rs;
     rs;
     ==> // coefficients: QQ considered as a field
     ==> // number of vars : 3
     ==> //        block   1 : ordering Ds
     ==> //                  : names    x y
     ==> //        block   2 : ordering ds
     ==> //                  : names    z
     ==> //        block   3 : ordering C


