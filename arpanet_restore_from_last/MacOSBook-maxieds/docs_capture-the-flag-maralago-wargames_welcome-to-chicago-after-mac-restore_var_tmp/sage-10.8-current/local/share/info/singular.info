     operator '+' for ncrat is overloaded
     with this procedure, hence
     ncrat h = f + g;
     yields the same result as
     ncrat h = ncratAdd(f, g);

*Example:*
     LIB "ncrat.lib";
     ncInit(list("x", "y", "z"));
     ncrat f = ncratFromString("2*x*y");
     print(f);
     ==> 2*x*y
     ncrat g = ncratFromString("z");
     print(g);
     ==> z
     ncrat h1, h2;
     h1 = ncratAdd(f, g);
     print(h1);
     ==> 2*x*y+z
     h2 = f + g;
     print(h2);
     ==> 2*x*y+z


