     // radical:
     setring r;
     ideal k=std(radical(i));
     vdim(k);                 // number of different complex solutions
     ==> 29
     def T1=solve(k,30,"nodisplay");  // compute all solutions with mult's
     ==>
     ==> // 'solve' created a ring, in which a list SOL of numbers (the complex so\
        lutions)
     ==> // is stored.
