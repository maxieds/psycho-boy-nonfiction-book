     ==> rules[1,1]=x
     ==> rules[1,2]=y
     ==> rules[2,1]=x2
     ==> rules[2,2]=y2
     homomorphism(rules,src,tar);
     ==> | x  y  |
     ==> | x2 y2 |
     ==>
     ==> cokernel | 1 0 | <--- R^2
     ==>          | 0 1 |
     ==>


