*Example:*
     LIB "decodegb.lib";
     ring r=3,(x(1..3)),dp;
     //generate all 3-vectors over GF(3)
     list points=pointsGen(3,1);
     list points2=convPoints(points);
     //grasps the first 11 points
     list p=graspList(points2,1,11);
     print(p);
     ==> [1]:
     ==>    _[1,1]=0
     ==>    _[2,1]=0
     ==>    _[3,1]=0
     ==> [2]:
     ==>    _[1,1]=0
     ==>    _[2,1]=0
     ==>    _[3,1]=1
     ==> [3]:
