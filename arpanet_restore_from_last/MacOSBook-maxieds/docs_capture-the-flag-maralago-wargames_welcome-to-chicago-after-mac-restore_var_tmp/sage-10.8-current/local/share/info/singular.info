     ==> _[2]=y4
     ==> _[3]=xy3
     ==> _[4]=x2y2
     ==> _[5]=x3y
     setBaseMultigrading(g1,l);
     multiDegBasis(v1);
     ==> _[1]=1
     setBaseMultigrading(g2);
