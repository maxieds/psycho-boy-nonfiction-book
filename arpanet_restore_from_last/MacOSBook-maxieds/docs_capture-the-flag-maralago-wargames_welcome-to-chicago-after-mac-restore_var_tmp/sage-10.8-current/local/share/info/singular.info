     ring R = 0,(s,t),dp;
     matrix A[3][3] = 1,s,st/2, 0,1,t, 0,0,1;
     matrixLog(A);
     ==> _[1,1]=0
     ==> _[1,2]=s
     ==> _[1,3]=0
     ==> _[2,1]=0
     ==> _[2,2]=0
     ==> _[2,3]=t
     ==> _[3,1]=0
     ==> _[3,2]=0
     ==> _[3,3]=0


