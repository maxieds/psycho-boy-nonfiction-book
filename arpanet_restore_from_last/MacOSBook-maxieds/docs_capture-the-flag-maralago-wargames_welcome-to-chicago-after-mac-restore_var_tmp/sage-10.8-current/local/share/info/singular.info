     ideal a = 0;
     bigintmat w[1][3] = 3,3,1;
     cone lambda = gitCone(a, Q, w);
     rays(lambda);
     ==> 1,0,0,
     ==> 0,1,0,
     ==> 1,1,1
     bigintmat w2[1][3] = 1,1,1;
     cone lambda2 = gitCone(a, Q, w2);
     rays(lambda2);
     ==> 1,1,1


