     ring S = 0, (x(0..3)), dp;
     list kos = grres(grobj(maxideal(1), intvec(0)), 0);
     print( betti(kos), "betti");
     ==>            0     1     2     3     4
     ==> ------------------------------------
     ==>     0:     1     4     6     4     1
     ==> ------------------------------------
     ==> total:     1     4     6     4     1
     ==>
     grview(kos);
