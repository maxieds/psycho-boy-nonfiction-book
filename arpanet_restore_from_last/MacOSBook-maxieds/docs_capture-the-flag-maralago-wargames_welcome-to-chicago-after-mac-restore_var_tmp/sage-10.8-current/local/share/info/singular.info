     ==>    [1]:
     ==>       _[1]=(3*x+4*y)
     ==>    [2]:
     ==>       [1]:
     ==>          _[1]=1
     ==>    [3]:
     ==>       [1]:
     ==>          1
     ==>       [2]:
     ==>          Normal
     ==>       [3]:
     ==>          _[1]=0
     ==> [2]:
     ==>    [1]:
     ==>       _[1]=(3*x-4*y)
     ==>    [2]:
     ==>       [1]:
     ==>          _[1]=1
     ==>    [3]:
     ==>       [1]:
     ==>          1
     ==>       [2]:
     ==>          Normal
     ==>       [3]:
     ==>          _[1]=0
     // E is a component of the envelope:
     def E=Env[1][1][1];
     E;
     ==> (3*x+4*y)
     def A=AssocTanToEnv(F,C,E);
     A;
     ==> [1]:
     ==>    _[1]=t
     ==> [2]:
     ==>    _[1]=12*t+(5*y)
     ==> [3]:
     ==>    [1]:
     ==>       [1]:
     ==>          _[1]=(3*x+4*y)
     ==>       [2]:
     ==>          [1]:
     ==>             _[1]=1
     // The basis of the parameter values of the associated
     //    tangent component is
