     matrix B[2][2]=1,0,2,0; matrix C[1][4]=4,5,x,y;
     print(A);
     ==> 1, 2, 3,
     ==> x, y, z,
     ==> x2,y2,z2
     print(B);
     ==> 1,0,
     ==> 2,0
     print(C);
     ==> 4,5,x,y
     print(concat(A,B,C));
     ==> 1, 2, 3, 1,0,4,5,x,y,
     ==> x, y, z, 2,0,0,0,0,0,
     ==> x2,y2,z2,0,0,0,0,0,0


