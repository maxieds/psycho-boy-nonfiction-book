     ==>    [2]:
     ==>       x
     ring r2 = 0,(x,y),dp;
     poly F = x2y+5xy2;
     poly2list(F);
     ==> [1]:
     ==>    [1]:
     ==>       2,1
     ==>    [2]:
     ==>       x2y
     ==> [2]:
     ==>    [1]:
     ==>       1,2
     ==>    [2]:
     ==>       5xy2
     poly2list(0);
     ==> [1]:
     ==>    [1]:
     ==>       0,0
     ==>    [2]:
     ==>       0


