     ==> x2+y2+xz+yz
     matrix M[2][3] = 1,x,2,y,3,z;
     intvec w=2,4,6;
     sum(M,w);
     ==> x+y+z
     intvec iv = 1,2,3,4,5,6,7,8,9;
     sum(iv,2..4);
     ==> 9
     iv = intvec(1..100);
     sum(iv);
     ==> 5050
     ring r2 = 0,(x(1..10)),dp;
     sum(x(3..7),intvec(1,3,5));
     ==> x(3)+x(5)+x(7)


