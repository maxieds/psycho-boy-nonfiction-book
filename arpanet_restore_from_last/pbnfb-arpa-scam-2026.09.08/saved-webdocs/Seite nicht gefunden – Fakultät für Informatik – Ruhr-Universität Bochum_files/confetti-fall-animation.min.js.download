jQuery(function($){var defaults={maxCount:confetti.maxCount,speed:confetti.speed,alpha:confetti.alpha,gradient:confetti.gradient,colors:Array.isArray(confetti.colors)?confetti.colors.slice():[]};function parseColors(value){if(!value){return[];}return value.split(',').map(function(color){color=color.trim();if(/^#[0-9a-f]{6}$/i.test(color)){return'rgba('+[parseInt(color.slice(1,3),16),parseInt(color.slice(3,5),16),parseInt(color.slice(5,7),16)].join(',')+',';}if(/^#[0-9a-f]{3}$/i.test(color)){return'rgba('+[parseInt(color.charAt(1)+color.charAt(1),16),parseInt(color.charAt(2)+color.charAt(2),16),parseInt(color.charAt(3)+color.charAt(3),16)].join(',')+',';}var rgbMatch=color.match(/^rgba?\((\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})/i);if(rgbMatch){return'rgba('+[rgbMatch[1],rgbMatch[2],rgbMatch[3]].join(',')+',';}return null;}).filter(Boolean);}function applyConfig($node){confetti.maxCount=Math.max(1,parseInt($node.attr('data-count'),10)||defaults.maxCount);confetti.speed=Math.max(0,parseFloat($node.attr('data-speed'))||defaults.speed);var alpha=parseFloat($node.attr('data-alpha'));confetti.alpha=Number.isFinite(alpha)?Math.min(1,Math.max(0,alpha)):defaults.alpha;confetti.gradient=$node.attr('data-gradient')==='true';var colors=parseColors($node.attr('data-colors'));confetti.colors=colors.length?colors:defaults.colors.slice();}function resetConfig(){confetti.maxCount=defaults.maxCount;confetti.speed=defaults.speed;confetti.alpha=defaults.alpha;confetti.gradient=defaults.gradient;confetti.colors=defaults.colors.slice();}$('.confetti-fall-animation').each(function(){var $node=$(this);var delay=1000*parseFloat($node.attr('data-delay'));var time=1000*parseFloat($node.attr('data-time'));if(delay<50||delay>3600*1000||time<50||time>3600*1000){return;}window.setTimeout(function(){applyConfig($node);confetti.start();window.setTimeout(function(){confetti.stop();resetConfig();},time);},delay);});});
