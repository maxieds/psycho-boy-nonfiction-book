document.addEventListener("DOMContentLoaded", function () {
  const formContainer = document.querySelector(".ffi-fback-form-container");
  if (!formContainer) return;

  const issueFields = document.getElementById("issue_fields");
  const suggestionFields = document.getElementById("suggestion_fields");
  const formTypeRadios = document.querySelectorAll('input[name="form_type"]');

  formTypeRadios.forEach((radio) => {
    radio.addEventListener("change", function () {
      issueFields.style.display = this.value === "issue" ? "block" : "none";
      suggestionFields.style.display =
        this.value === "suggestion" ? "block" : "none";
    });
  });

  document
    .getElementById("issue_other")
    ?.addEventListener("change", function () {
      document
        .getElementById("other_issue_details")
        ?.classList.toggle("show", this.checked);
    });
});
