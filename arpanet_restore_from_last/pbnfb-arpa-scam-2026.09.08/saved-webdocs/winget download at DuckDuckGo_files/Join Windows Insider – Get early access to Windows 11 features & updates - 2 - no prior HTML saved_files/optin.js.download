function onConsentChanged(categoryPreferences) {
  const isGpcdisabled = getGpcvalue();
  if (categoryPreferences.Analytics && categoryPreferences.SocialMedia && categoryPreferences.Advertising && GPC_DataSharingOptIn && isGpcdisabled)  {
    addFunctions();
  } else {
    //Clicktale
    expireCookie("_cs_s");
    expireCookie("_cs_id");
    expireCookie("__CT_Data");
    expireCookie("ctm");
    expireCookie("_cs_c");

    //GA
    expireCookie("_gid");
    expireCookie("_ga");
    expireCookie("_gat_gtag_UA_99817921_2");

    //FB Pixel
    expireCookie("_fbp");

    //clarity
    expireCookie("_clck");
    expireCookie("_clsk");
    expireCookie("_cs_cvars");
    expireCookie("_cs_cvars___2422","cdnssl.clicktale.net");
    expireCookie("_cs_id___2422","cdnssl.clicktale.net");
    expireCookie("_cs_s___2422","cdnssl.clicktale.net");
    expireCookie("bcookie","linkedin.com");
    expireCookie("lidc","linkedin.com");
    expireCookie("li_gc","linkedin.com");  
    expireCookie("UserMatchHistory","linkedin.com");
    expireCookie("li_sugr","linkedin.com");
    expireCookie("AnalyticsSyncHistory","linkedin.com");
    
  }
}

function getGpcvalue(){
  if(navigator && navigator.globalPrivacyControl){
    if(navigator.globalPrivacyControl == false|| navigator.globalPrivacyControl == 0){
      return true;
    }
    else{
      return false;
    }
  }
  else{
    return true;
  }
}

