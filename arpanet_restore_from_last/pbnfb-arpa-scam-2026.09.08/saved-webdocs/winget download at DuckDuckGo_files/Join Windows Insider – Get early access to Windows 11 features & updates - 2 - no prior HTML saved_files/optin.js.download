
// mscc will only exist if written by the server
// mscc is undefined when consent not need, such as en-us where the is no Consent API
function expireCookie(cname, domain = "microsoft.com") {
  var d = new Date();
  d.setMonth(d.getMonth() - 5);
  var expires = "expires=" + d.toUTCString();
  if (domain && (domain === "microsoft.com" || domain === "windows.com")) {
    if (window.location.hostname && window.location.hostname.endsWith('microsoft.com')) {
      domain = "microsoft.com"
    } else if (window.location.hostname && window.location.hostname.endsWith('windows.com')) {
      domain = "windows.com"
    }
  }
  var path = `${cname} =;Max-Age=0;path=/;domain=.${domain}`;
  document.cookie = path;
}

