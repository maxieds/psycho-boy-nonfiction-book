(function () {
  let timeout = null;
  function init() {
    if (typeof WcpConsent !== "undefined") {
     if(timeout){
       clearTimeout(timeout);
       timeout = null;
     }
     WcpConsent.onInitCallback(onConsentChanged);
     WcpConsent.onConsentChanged(onConsentChanged);
    } else {  
      timeout = setTimeout(init, 100);
    }
  }
  init();
})();


