<span class=3D"go">            mingw-w64-ucrt-x86_64-mpfr-4.2.2-3</span>
<span class=3D"go">            mingw-w64-ucrt-x86_64-tzdata-2026c-1</span>
<span class=3D"go">            mingw-w64-ucrt-x86_64-windows-default-manife=
st-20260815-1</span>
<span class=3D"go">            mingw-w64-ucrt-x86_64-winpthreads-14.0.0.r28=
3.ga7cb47123-1</span>
<span class=3D"go">            mingw-w64-ucrt-x86_64-zlib-1.3.2-2</span>
<span class=3D"go">            mingw-w64-ucrt-x86_64-zstd-1.5.7-2</span>
<span class=3D"go">            mingw-w64-ucrt-x86_64-gcc-16.2.0-3</span>

