n>
<span class=3D"go">            mingw-w64-ucrt-x86_64-crt-14.0.0.r283.ga7cb4=
7123-1</span>
<span class=3D"go">            mingw-w64-ucrt-x86_64-gcc-libs-16.2.0-3</spa=
n>
<span class=3D"go">            mingw-w64-ucrt-x86_64-gettext-runtime-1.0-1<=
/span>
<span class=3D"go">            mingw-w64-ucrt-x86_64-gmp-6.3.0-2</span>
<span class=3D"go">            mingw-w64-ucrt-x86_64-headers-14.0.0.r283.ga=
7cb47123-1</span>
<span class=3D"go">            mingw-w64-ucrt-x86_64-isl-0.28-1</span>
<span class=3D"go">            mingw-w64-ucrt-x86_64-libiconv-1.19-1</span>
