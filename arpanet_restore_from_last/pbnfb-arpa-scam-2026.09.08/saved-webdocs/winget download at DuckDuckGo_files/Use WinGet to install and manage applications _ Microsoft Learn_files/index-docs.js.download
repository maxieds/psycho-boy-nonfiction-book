ions/ask/">re-ask the question</a> or explore other questions on the <a href="{productPageUrl}">{product}</a> page.`,ate="This question has been retired";var lte="Maximum number of attachments exceeded. Please select up to {maximumCount} attachments.";var cte="Maximum number of mentions exceeded. Please select up to {maximumCount} mentions.";var R2="You must confirm that you are not posting Microsoft internal or confidential information.";var ute="User is already suspended. Please refresh the page.",dte="User is not suspended. Please refresh the page.";var pte="You cannot take this action because your account has been suspended due to a violation of our Code of Conduct. Your account was manually reported or identified through automated detection before action was taken. Please refer to our Code of Conduct for more information.";var mte="This answer was helpful",gte="This answer was not helpful";var M2="Report a concern",$2="Report reason";var fte=`<a class='docs-sign-in' href="#">Sign in</a> to opt into email updates on your reported concern`,hte="Allow Microsoft to contact me about this report",bte="Full Name",_te="Email",yte='We will contact you through your personal account <span id="report-msa-email-account" class="font-weight-bold">{email}</span>',vte='Microsoft is committed to helping our users and to protecting your privacy. You may read the <a href="https://privacy.microsoft.com/privacystatement">Microsoft Privacy Statement</a> if you would like more information on how we protect personal data.';var xte="Question",Qp="Question author",D2='<p><span class="font-weight-semibold">Question author filtering</span></p><p>When filtering by question author, you can only filter by <span class="font-weight-semibold">one user</span> at a time and only filter by <span class="font-weight-semibold">Learn users.</span></p>',N2="Questions";var Tte="Question already answered.";var wte="Required question.",Ste="Optional question.",Cte="Quick Filters";var F2="Read in English",Ete="Read in {language}";var Ate="Recommended content",Qo="Reference";var kte="References";var Ou="Refresh";var ih="Remove",O2="Remove {itemName}";var U2="Renew";var gk="Report a concern",Ite="Select reason",q2="Adult and sexual",Pte="AI accuracy",H2="Child sexual exploitation and abuse imagery",B2="Coordination of harm",Lte="Defamation, impersonation, false information",z2="Bullying and harassment",G2="Graphic violence and gore",V2="Hate speech and discrimination",j2="Non-consensual intimate imagery & intimate extortion",Rte="Off topic or irrelevant posts",Q2="Other Terms of Use or Code of Conduct violation",Mte="Personal or sensitive user information",Y2="Profanity and vulgarity",W2="Sexual solicitation",$te="Spam";var K2="Suicide and self-injury",J2="Terrorism and violent extremism",Z2="Trafficking",X2="Violent threats, incitement, and glorification of violence";var Dte="Request Preview",eF="Request URL";var ma="Required fields are marked with an asterisk";var Nte="Types";var Fte="Response Code";var tF="Restart";var Ote="{numberOfResults} result",fk="{numberOfResults} results";var ah="Resume",hk="Retake";var Ute="Role";var qte="Learning path";var Hte="Roles";var Bte="RSS",zte="Run";var bk="We're encountering an issue with the security verification process required to activate the resource. Please retry after 10 minutes.",nF=`We have reviewed your appeal and determined that your account has violated our <a href="https://learn.microsoft.com/en-us/legal/termsofuse" data-linktype="external">Terms of Use</a>. Your interactive resource access will not be reinstated. However, you can continue to access Microsoft Learn's training content. Many module exercises can be completed using your personal subscription, but charges may apply, and you may need to modify the instructions to work with your subscription.`;var lt="Save";var Gte="Skill";var oF="Add to Plans",rF="Added to Plans",Vte="Manage {title} in Plans",jte="Add {title} to a plan";var sF="Copy plan",Qte="Days to milestone: {number}";var Yte="Estimated time to complete: {time}";var Wte="{number} milestone(s) in this plan";var Kte="Milestone {number}",Jte='Added to <a href="{url}" class="has-text-tertiary-invert text-decoration-underline">{collectionName}</a>',Zte='Added to <a href="{url}" class="has-text-tertiary-invert text-decoration-underline">Plans</a>',Xte="Sign in to Microsoft Learn to use AI to build a personalized and tailored learning plan that considers your unique needs and provides the most relevant content.",ene='Removed from <a href="{url}" class="has-text-tertiary-invert text-decoration-underline">{collectionName}</a>',tne='Removed from <a href="{url}" class="has-text-tertiary-invert text-decoration-underline">Plans</a>',_k="Background",nne="Current role",one="Choose a role",yk="Provide your career background information.",rne="Provide your detailed title and responsibilities",sne="What's your career stage?",ine="Early career (0-5 years)",ane="Mid-career (5-10 years)",lne="Advanced career (10+ years)",cne="Build your plan",une="{AppliedSkills} (scenarios-based, interactive lab assessments)",dne="Complete a challenging project at work",pne="Earn a professional credential in your field",mne="Enhance a skillset, such as learning a new software tool or programming language",gne="Enter project technologies, goals, and success metrics",fne="Hold down Ctrl button on Windows/Command button on Mac to select multiple options.",hne="Provide project details",bne="Scenario-based credentials that are earned through practical, interactive lab assessments demonstrating your proficiency and ability to implement a real-world solution.";var iF="Select category",ix="Select certification",_ne="Select credential",vk="Select a skill",aF="Select subject",yne="Select type of credential",vne="What are your career goals?",xne="Choose your plan goal",xk="Complete a specific project",Tne="Provide a detailed project description including a problem statement and the expected outcome along with technologies, frameworks, languages, or services that you're using.",wne="Provide your detailed title and responsibilities",Sne="What is the project goal, problem, and expected outcome? Include any technologies, frameworks, languages, and services that you're using.",Cne="Dos and don'ts when describing the project",Ene=`<strong>Do:</strong> "I'm developing a web-based application that leverages machine learning algorithms to predict inventory needs, track stock levels in real-time, and automate reordering processes.<br /><br />The main features are real-time inventory tracking, predictive analytics, automated reordering and a reporting/analytics.<br /><br />Technologies we will use are Microsoft Blazor for the frontend user interface, ASP.NET Core for server-side logic and API requests, Azure Cosmos DB for storing inventory data and transactions, Azure Machine Learning and Azure cloud services."`,Ane=`<strong>Don't:</strong> "I need to build an inventory tracking web app."`,kne='Take a few minutes to help us build your learning plan with AI\u2014personalized to you! Microsoft will never share this data. Please read the <a href="/training/support/plans-transparency-note">AI transparency notes</a> to learn more about use cases and limitations and <a href="https://privacy.microsoft.com/privacystatement">privacy policy</a>.',Tk="Earn a credential",Ine="How do you want to gain credentials?",Pne="Validate skills through a scenario-based assessment",wk="Select the most relevant {AppliedSkills}",Lne="Earn an industry-recognized, role-based Microsoft certification",Sk="Industry-recognized certifications",Ck="Hmm, something went wrong. Please try again.",Rne="The plan wasn't generated because the form might include wording that may be in violation of Microsoft Learn code of conduct. Please start over and change your phrasing.",Mne="Unfortunately, we couldn't generate your plan. Please start over.",$ne="We couldn't open your plan. Please try again.",Dne="We couldn't find credentials for this role. Please select a different role and try again.",Ek="Enter detailed title and responsibilities which can help our AI system to better personalize your learning plan. We recommend adding your job title and details about specific tasks you perform which relate to your plan goal";var Nne="Give as many details as you can, but don't include any private or sensitive information",lF="Is this plan helpful?",Fne="Prompts and generated responses will be shared. Preview what will be shared {here}",cF="This plan is helpful",uF="This plan is not helpful",One="We appreciate you taking the time to rate the suggested plan and provide comments. Your input will help us improve our experience.",Une="What about the plan could be improved?",qne="What did you like about the plan?",Hne="Goal",Bne="Generate plan",Ak="Generating your plan...",zne="Almost there",Gne="Almost there - we're just putting the final touches to ensure everything is perfect!",Vne="Completion time",jne="Now, we're estimating milestone completion time based on your learning pace.",Qne="Next, we're outlining your learning outcomes.",Yne="Lastly, we're setting milestones including key stages and checkpoints.",Wne="First, we're generating your plan title and description that'll define the purpose and scope of your project.",Kne="Title and description",kk="Grow in current career",Jne="How does it work?",Zne='Each AI-generated plan is based on your selections and the info you provided. We curate relevant content from Microsoft to create a personalized plan. This plan includes tailored training and documentation, organized milestones, progress tracking tools for individuals or groups, and recognition upon completion. Learn more about how <a class="font-weight-normal" href="https://learn.microsoft.com/en-us/training/support/plans-transparency-note">AI plan generation</a> works and its limitations.',lh="Objectives",Ik="Provide more information about your career goals.",Pk="Start a new career",Xne="Enter detailed title and responsibilities. We recommend using specific job title(s) and/or detailed responsibilities that relate to your plan goal. This helps our AI system to be more personalized and accurate.",eoe="Role description",toe="Select role",noe="Select the most relevant role",ooe="What role are you interested in exploring?",roe="Start over without saving",soe="Start over without saving your plan?",ioe="If you start over, the plan and info you entered won't be saved, and you'll need to reenter your details and preferences.",aoe="Take a few minutes to help us build your learning plan with AI\u2014personalized to you!",ax="Tell us your goal",loe="Add as much information and detail as possible",coe='Example: "My goal is to become proficient in Azure AI services. I want to learn how to build, deploy, and manage AI models using Azure Machine Learning. Additionally, I aim to understand how to integrate these models into our existing applications to enhance their capabilities and provide better insights."',lx="Timeline",cx="Let us know how much time you have to work on your plan.",uoe="How much time can you dedicate weekly?",doe="When do you want to finish your learning plan?",poe="Less than 1 hour",moe="1-2 hours",goe="3-5 hours",foe="5-10 hours",hoe="More than 10 hours",boe="Within 3 months",_oe="3-6 months",yoe="6-12 months",voe="More than 12 months";var ch="Review plan";var xoe="Success! Your new plan is ready. Please review as AI-generated content may be inaccurate.";var Toe="Example plan",woe="This skilling plan guides you through developing AI solutions using Azure AI Services, focusing on natural language processing, generative AI, and custom AI applications. You'll learn to leverage Azure's powerful tools and services effectively.";var Soe="By the end of this plan, you'll be able to create and deploy AI solutions using Azure AI Services, including natural language processing and generative AI applications.",Coe="By the end of this plan, you'll be able to implement custom AI applications using Azure OpenAI Service and Azure AI Studio.",Eoe="By the end of this plan, you'll be able to develop intelligent applications that utilize Azure AI capabilities for various use cases.",Aoe="Learn foundational Azure AI services",koe="In this section, learners will explore the basics of Azure AI Services, gaining foundational knowledge to build AI solutions. Key technologies include Azure AI Services, with tasks such as understanding service capabilities and initial setup.",Ioe="Get started with Azure AI Services",Poe="Develop advanced AI solutions with Azure",Loe="This section focuses on developing advanced AI solutions, including natural language processing and generative AI. Learners will work with Azure AI Services and Azure OpenAI Service, engaging in tasks like building language models and creating custom copilots.",Roe="Develop natural language processing solutions with Azure AI Services",Moe="Develop applications with Azure OpenAI in Foundry Models",$oe="Develop your own custom copilots with Azure AI Studio",Doe="Develop AI Solutions with Azure AI Services",Noe='<a href="{url}" class="has-text-tertiary-invert text-decoration-underline">Plans</a> updated';var Foe="Choose a different name for your plan",Ooe="Copy Link";var Lk="Manage";var Rk="Leave",Uoe="Leave plan",qoe="Are you sure you want to leave this plan?",Hoe="You'll lose all records of your progress, and won't appear in the creator's report.",Boe="Yes, leave",zoe="Enter a title";var Goe="Sorry, this plan is private.",Voe="The creator of this plan has marked it as private and it is not currently visible to other users.",joe="You can review your Plans in your user profile.",Qoe="View your Plans",Yoe='You can also return to <a href="{url}" class="color-text text-decoration-underline">Plans</a>.',Woe="Plan unavailable",Koe="This plan does not exist or was removed.",Joe="If this link was shared with you, request a new link.",Zoe="Completed";var Xoe="A plan allows learners to progress through a set of milestones to achieve learning outcomes. You can invite learners to your plan and track their progress.",ere="Started";var tre="Official plan";var nre="Plan not found. Please refresh the page.",ore="One or more milestones is empty or is missing the recommended days to complete. Please fix these issues before publishing the plan.",rre="Plan details";var sre="Delete plan",ire="To delete your plan, ensure no users are joined to it. All users must drop the plan first.",are="Are you sure that you want to delete the following plan?",lre="Yes, delete plan";var uh="Invite learners",dF="Copy invite link",cre="Link copied to clipboard",ure="Delete learning group",dre="You are about to delete the following learning group: <strong>{learningGroupName}</strong>. Do you want to proceed?",pre="Group deleted",mre="Groups",ux="Group name",gre="Individuals";var fre="A learning group is a name that allows you to identify a group of learners in your progress report; learners will not see this name.<br/><br/>Creating a learning group generates a unique link to your plan for the specific group of learners.";var pF="New learning group",hre="Please enter a name for this learning group",bre="Your invitation to start {planTitle} plan on Microsoft Learn",_re="Start your plan and begin your learning journey today.",yre="You have been invited to start the {planTitle} plan on Microsoft Learn.",vre="A plan is a set of curated and organized content on Microsoft Learn with milestones designed to help you to achieve learning outcomes.",xre="By completing this plan, you\u2019ll achieve the following learning outcomes:",Tre="Start your plan today!",dh="View progress",wre="Download this file to view a list of learners and their progress.",Mk="Download CSV",Sre="The file contains the following information:",Cre="Learner group",Ere="Learn username",Are="Start date",kre="End date",Ire="Items completed",Pre="Items total",Uu="Learning outcomes",Lre="Edit learning outcomes",Rre="A learning outcome is specific knowledge, skills, or expertise that the learner will get from completing this plan.",Mre="Tip: Begin each learning outcome with a verb. Each outcome should finish the sentence \u201CUpon completion of this plan, learners will be able to...\u201D";var $re="Outcome 1",Dre="Outcome 2 (optional)",Nre="Outcome 3 (optional)",Fre="Outcome {number}",Ore="Convert to an official plan",Ure="Convert a plan to an official plan",qre="An official plan should be used when you want your plan to <strong>represent Microsoft</strong> and if you would like to include links that are external to Microsoft Learn. Always ensure that your plan is complete, free of typographical errors, and that content is in the correct sequence. <strong>Once an official plan is published, it cannot be altered.</strong>",Hre="To preserve any external links from an underlying Official Collection or plan, please convert to an official plan.",Bre="An official plan represents Microsoft, so please ensure that your published plan is complete, free of typographical errors, and that content is in the correct sequence.";var $k="This plan has been submitted to be localized",zre="The plan is complete and proofread",Gre="Thank you for submitting your official plan for localization.",Vre="Mark as completed",mF="Milestone",jre="Add milestone",Qre="Edit milestone";var Yre="New milestone",Wre="Days to milestone:",Kre="1 milestone",Jre="{numberOfMilestones} milestones";var Zre="Milestone completed";var Xre="Move to";var ese="Please confirm all milestones have a title and days to complete. You may need to expand each milestone.";var tse="Mark as complete?",nse="Do you want to mark it complete? Once you mark it as complete, you won't be able to review it again.",ose="Welcome!",rse="To start this plan, you have to share your plan progress data with the creator of the plan. The data that will be shared is: the dates that you start and complete the plan and how many items of the total you have completed at any point in time. Your data will be associated with your public Learn username.",sse="Do you agree to share your progress?",ise="Yes, I agree to share my progress",ase="If you would like to receive useful emails to guide and encourage you through your Plans journey, please go to your Profile Settings page and provide a contact email for notifications.",lse="Save all items in this plan as a new",cse="Please sign in to add this to your plan.";var use="You don't have any plans yet.",gF="A learner group with this name exists already. Please enter a different name";var dse="Reported plan",pse='A concern has been reported on this plan and it is currently under Microsoft review. Please refer to our <a href="/legal/termsofuse">Terms of Use</a> for more information.';var mse="Save your customized collection";var fF="Schedule exam";var sn="Search";var gse="Search all across Microsoft Learn";var hF="Search filters";var fse="Search Microsoft Learn",hse="Search documentation",dx="Search previous versions";var Dk="Seconds",bse="{duration} seconds ago",_se="{seconds} seconds",Nk="Section",yse="Section titled: {title}";var px="See less";var qu="See more";var Fk="Select Package";var Ok="Select Version";var vse="Service";var Yp="Settings",Uk="Share";var qk="[Shared Article] {articleTitle}",xse="I completed {achievementTitle}! I'm so proud to be celebrating this achievement and hope this inspires you to start your own @MicrosoftLearn journey!";var mx="Share to your feed:";var bF="Share via";var Tse="Share your achievement:",wse="Sharing",Sse="Sharing is disabled for content requiring authorization.";var ph="Show less",Hu="Show more",Hk="Show {number} more",Bk="Signed In",Kr="Sign in";var Cse="Signing in...";var Ese='Sign in to <span class="text-gradient-purple-blue">Microsoft Learn</span>';var gx="Sign in to start",Wp="Sign out";var Ase="Site";var kse="{count} more",zk="Clear filters",Ise="Hide filter",_F="{filter} options";var Pse="Queried terms:",yF="Thinking...",vF="Generating result...",xF="Searching...",Lse="Search Results",TF="Sorry, I can't help with this. Please make a new request or share your feedback.",wF="Sorry, you have sent too many requests in a short period of time. Please wait a moment and try again.",Rse="Accurate/relevant content",Mse="Complete/clear content",$se="Fast response",Dse="Inaccurate/irrelevant content",Nse="Incomplete/unclear content",Fse="Offensive/inappropriate content",Ose="Slow response",SF="Something else",CF="Give as much detail as you can, but do not include any private or sensitive information",Use="Tell us more",qse="This answer was helpful",Hse="This answer was not helpful",mh="AI Summary",Kp="Sorry, something went wrong. Please try again later.",EF="Summaries are temporarily unavailable, please try again later.";var AF="Failed to fetch summary",kF="Invalid summary response";var Bu="AI-generated content may be incorrect.",gh='Read our AI transparency notes for <a href="https://learn.microsoft.com/training/support/search-instant-answer-transparency-note" data-bi-name="search-answer-more-info">more information</a>.',Bse='Read our AI transparency notes for <a data-bi-name="ai-summary-more-info" data-bi-an="ai-summary" href="https://learn.microsoft.com/training/support/ai-summary-transparency-note">more information</a>.',fh="Thanks for your feedback!",fx="Hide",IF="Show",Gk="Generating...",zse="Please wait a moment and try again.",Vk="We don't have that information yet.",Gse='{count} results for "{searchPhrase}"',Vse='{count} result for "{searchPhrase}"',jse='{count} similar results for "{searchPhrase}"',Qse='{count} similar result for "{searchPhrase}"',Yse='{count} results for "{searchPhrase}" in {scope}',Wse='{count} result for "{searchPhrase}" in {scope}',Kse='{count} similar results for "{searchPhrase}" in {scope}',Jse='{count} similar result for "{searchPhrase}" in {scope}',Zse='No match found, showing {count} results similar to "{searchPhrase}".',Xse='No match found, showing {count} result similar to "{searchPhrase}".';var eie="or view all results on Microsoft Learn",tie='{count} results for "{searchPhrase}" in {scope} {pivotCategory}',nie='{count} result for "{searchPhrase}" in {scope} {pivotCategory}',oie='{count} similar results for "{searchPhrase}" in {scope} {pivotCategory}',rie='{count} similar result for "{searchPhrase}" in {scope} {pivotCategory}',hh="Sorry, we couldn't find anything that fit your search.",sie="We tried spell-checking and widening the scope of your search, but were still unable to find anything. Try a different keyword or phrase.",iie="A safeguard hold is currently in place on your device. Details are not available at this time. When the update is available, you\u2019ll see it on the Windows Update page in Settings.",aie="The update is not yet available for your device",lie="Sorry, we couldn't find anything that fit your search in {scope}.",cie='You can still <button id="search-globally-btn" class="link-button has-inner-focus">view all results in Microsoft Learn</button>.',uie=`We couldn't find any results matching "{searchPhrase}"`,die=`We couldn't find any results matching "{searchPhrase}" in {scope}`;var sl="Hmm, something went wrong",Zt="Something went wrong. Please try again.";var Jp="GitHub";var pie="Sort by:";var ga="Start",mie="Starts {startDate}",gie="Start Date";var fie="Starting date";var hie="Start over";var bie="Step {step-index} of {step-count}",_ie="Manage {title} in study guides",yie="Add {title} in study guides";var vie="Subject",xie="Subjects",Fn="Submit";var Tie="Submit another feedback";var wie="Successfully Submitted!",Sie="Thank you for submitting your feedback. We will review it shortly. Please note that feedback reporting is a one way communication and we are not responding back at this time.",Cie="Please note that although we cannot respond to feedback, our team will use your comments to improve the experience.";var Eie="Suggestions",Aie="Suggestions will filter as you type";var kie="Support";var Iie="Table {in