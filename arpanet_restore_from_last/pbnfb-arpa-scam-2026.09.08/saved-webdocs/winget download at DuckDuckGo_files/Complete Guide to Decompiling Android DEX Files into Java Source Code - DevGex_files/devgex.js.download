// 全站通用JS

// 读取cookie
function getCookie(name) {
    let c = document.cookie.match("\\b" + name + "=([^;]*)\\b");
    return c ? c[1] : undefined;
}

const _xsrf = getCookie("_xsrf");

// cookie是否同意
function cookie_select(v) {
    $.ajax({
        url: "/api/cookie_select",
        type: "POST",
        data: {
            v: v,
            _xsrf: _xsrf
        },
        success: function (res) {
            console.log(res);
            location.reload();
        }
    });
}

$(document).ready(function() {
    // cookie询问的同意按钮
    $('#cookie-accept').click(function() {
       cookie_select("Y");
    });
    
    // cookie询问的拒绝按钮
    $('#cookie-reject').click(function() {
       cookie_select("N");
    });
});