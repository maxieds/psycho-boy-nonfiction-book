);\n                                            e.stopPropagation();\n                                            leftArrow.click();\n                                            keepPlaying(wrapper);\n                                        });\n\n                                        var next = document.createElement('button');\n                                        next.type = 'button';\n                                        next.className = 'gfg-mobile-carousel-nav gfg-mobile-carousel-nav-right';\n                                        next.setAttribute('aria-label', 'Next slide');\n                                        next.innerHTML = RIGHT_SVG;\n                                        next.addEventListener('click', function (e) {\n                                            e.preventDefault();\n                                            e.stopPropagation();\n                                            rightArrow.click();\n                                            keepPlaying(wrapper);\n                                        });\n\n                                        wrapper.appendChild(prev);\n                                        wrapper.appendChild(next);\n                                    }\n\n                                    function playIfPaused(wrapper) {\n                                        if (!wrapper) return;\n                                        var playpause = wrapper.querySelector('.gfg-preview-carousel-playpause');\n                                        if (playpause && playpause.querySelector('[aria-label=\"Play\"]')) {\n                                            playpause.click();\n                                        }\n                                    }\n\n                                    function keepPlaying(wrapper) {\n                                        if (!wrapper || window.innerWidth > MOBILE_MAX_WIDTH) return;\n                                        var tries = 0;\n                                        var timer = setInterval(function () {\n                                            tries++;\n                                            playIfPaused(wrapper);\n                                            if (tries >= 8) clearInterval(timer);\n                                        }, 200);\n                                    }\n\n                                    // Start the built-in autoplay for the inline carousel below 768px.\n                                    function ensurePlaying(carousel) {\n                                        if (window.innerWidth > MOBILE_MAX_WIDTH || playStarted.has(carousel)) return;\n                                        var wrapper = carousel.closest('.gfg-preview-carousel-wrapper') || carousel.parentElement;\n                                        if (!wrapper) return;\n                                        playStarted.add(carousel);\n                                        playIfPaused(wrapper);\n\n                                        carousel.addEventListener('click', function () {\n                                            if (window.innerWidth > MOBILE_MAX_WIDTH) return;\n                                            var w = carousel.closest('.gfg-preview-carousel-wrapper') || carousel.parentElement;\n                                            if (!w) return;\n                                            setTimeout(function () { playIfPaused(w); }, 400);\n                                        });\n                                    }\n\n                                    function initSwipe(carousel) {\n                                        if (!carousel || swipeInitialized.has(carousel)) return;\n                                        swipeInitialized.add(carousel);\n\n                                        var startX = 0;\n                                        var startY = 0;\n                                        var tracking = false;\n\n                                        carousel.addEventListener('touchstart', function (e) {\n                                            if (window.innerWidth > MOBILE_MAX_WIDTH) return;\n                                            if (!e.touches || e.touches.length !== 1) return;\n                                            tracking = true;\n                                            startX = e.touches[0].clientX;\n                                            startY = e.touches[0].clientY;\n                                        }, { passive: true });\n\n                                        carousel.addEventListener('touchend', function (e) {\n                                            if (!tracking) return;\n                                            tracking = false;\n                                            if (window.innerWidth > MOBILE_MAX_WIDTH) return;\n\n                                            var touch = (e.changedTouches && e.changedTouches[0]) || null;\n                                            if (!touch) return;\n\n                                            var deltaX = touch.clientX - startX;\n                                            var deltaY = touch.clientY - startY;\n\n                                            // Ignore mostly-vertical gestures (scrolling).\n                                            if (Math.abs(deltaX) < SWIPE_THRESHOLD || Math.abs(deltaX) <= Math.abs(deltaY)) return;\n\n                                            var wrapper = carousel.closest('.gfg-preview-carousel-wrapper') || carousel.parentElement;\n                                            if (!wrapper) return;\n\n                                            var selector = deltaX < 0 ? '.gfg-preview-carousel-right' : '.gfg-preview-carousel-left';\n                                            var arrow = wrapper.querySelector(selector);\n                                            if (arrow) arrow.click();\n                                            keepPlaying(wrapper);\n                   