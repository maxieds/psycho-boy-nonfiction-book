graphName "builtin_microphone_voice_raw"

; Uncomment the fs definition below if you want to process the graph offline
;[def fs 48000]
[def numChansIn 3]
[def numChansOut 3]

in in
out out
box gain dbgn 1 1

wire in gain ([fs] [numChansOut])
wire gain out ([fs] [numChansOut])

param vppg -1

param mvol 0
param mmut 1
wireGraphParam mmut (gain 1)


