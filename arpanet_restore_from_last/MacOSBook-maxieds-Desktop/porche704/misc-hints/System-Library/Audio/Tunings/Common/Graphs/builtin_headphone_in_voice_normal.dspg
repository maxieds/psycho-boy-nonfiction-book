graphName "builtin_headphone_in_voice_normal"

; Uncomment the fs definition below if you want to process the graph offline
;[def fs 48000]
[def numChansIn 1]
[def numChansOut 1]

in in
out out
box pregain dbgn 1 1

wire in pregain ([fs] [numChansOut])
wire pregain out ([fs] [numChansOut])

param vppg -1

param mvol 0
param mmut 0
wireGraphParam mmut (pregain 1)
